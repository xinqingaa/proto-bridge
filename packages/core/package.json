{
  "name": "@proto-bridge/core",
  "version": "0.4.0",
  "description": "Core adapters and generators for ProtoBridge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflows/capability-first": {
      "types": "./dist/workflows/capability-first/index.d.ts",
      "import": "./dist/workflows/capability-first/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./target/flutter-app": {
      "types": "./dist/target/flutter-app/index.d.ts",
      "import": "./dist/target/flutter-app/index.js"
    },
    "./source/vue3-prototype": {
      "types": "./dist/source/vue3-prototype/index.d.ts",
      "import": "./dist/source/vue3-prototype/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "import": "./dist/snapshot/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2/index.js"
    },
    "./v2/evidence-read-model": {
      "types": "./dist/v2/evidence-read-model.d.ts",
      "import": "./dist/v2/evidence-read-model.js"
    },
    "./v2/store": {
      "types": "./dist/v2/store/index.d.ts",
      "import": "./dist/v2/store/index.js"
    },
    "./v2/runtime-contract": {
      "types": "./dist/v2/runtime-contract/index.d.ts",
      "import": "./dist/v2/runtime-contract/index.js"
    },
    "./v2/capture": {
      "types": "./dist/v2/capture/index.d.ts",
      "import": "./dist/v2/capture/index.js"
    },
    "./v2/service-contract": {
      "types": "./dist/v2/service-contract/index.d.ts",
      "import": "./dist/v2/service-contract/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.34",
    "@vue/compiler-sfc": "^3.5.34",
    "fast-glob": "^3.3.2",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
