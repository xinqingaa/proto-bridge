{
  "name": "@proto-bridge/core",
  "version": "0.4.0",
  "description": "Evidence contracts, capture, storage, and target-query boundaries for ProtoBridge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./target/flutter-app/query": {
      "types": "./dist/target/flutter-app/query.d.ts",
      "import": "./dist/target/flutter-app/query.js"
    },
    "./target/flutter-app/validation": {
      "types": "./dist/target/flutter-app/validation/index.d.ts",
      "import": "./dist/target/flutter-app/validation/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2/index.js"
    },
    "./v2/evidence-read-model": {
      "types": "./dist/v2/evidence-read-model.d.ts",
      "import": "./dist/v2/evidence-read-model.js"
    },
    "./v2/agent-prompt": {
      "types": "./dist/v2/agent-prompt.d.ts",
      "import": "./dist/v2/agent-prompt.js"
    },

    "./v2/store": {
      "types": "./dist/v2/store/index.d.ts",
      "import": "./dist/v2/store/index.js"
    },
    "./v2/runtime-contract": {
      "types": "./dist/v2/runtime-contract/index.d.ts",
      "import": "./dist/v2/runtime-contract/index.js"
    },
    "./v2/capture": {
      "types": "./dist/v2/capture/index.d.ts",
      "import": "./dist/v2/capture/index.js"
    },
    "./v2/service-contract": {
      "types": "./dist/v2/service-contract/index.d.ts",
      "import": "./dist/v2/service-contract/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "playwright": "^1.49.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
