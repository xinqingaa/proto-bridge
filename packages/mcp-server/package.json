{
  "name": "@proto-bridge/mcp-server",
  "version": "0.4.0",
  "description": "MCP server for fixed ProtoBridge Evidence consumption and target validation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "proto-bridge-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node ../../scripts/verify-consumer-contract.mjs && node scripts/generate-build-info.mjs && pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@proto-bridge/core": "workspace:*",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED"
}
