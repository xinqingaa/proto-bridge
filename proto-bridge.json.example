{
  "schemaVersion": 1,
  "workspaceId": "pbwork-local",
  "runtime": {
    "baseUrl": "http://127.0.0.1:3977",
    "allowedOrigins": []
  },
  "store": {
    "root": ".proto-bridge/store",
    "retainArchivedSnapshots": 1
  },
  "capture": {
    "maxCases": 200
  },
   "delivery": {
    "targetRoot": "apps/flutter_pb_app"
  },
  "service": {
    "host": "127.0.0.1",
    "port": 3988,
    "allowedOrigins": ["http://127.0.0.1:3977"]
  }
}
