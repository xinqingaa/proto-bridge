{
  "name": "@proto-bridge/pbwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @proto-bridge/core build",
    "dev": "vite",
    "prebuild": "pnpm --filter @proto-bridge/core build",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "pretypecheck": "pnpm --filter @proto-bridge/core build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @proto-bridge/core build",
    "test": "vitest run",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "pretest:e2e:v2-capture": "pnpm build",
    "test:e2e:v2-capture": "playwright test e2e/runtime-capture-v2.spec.ts",
    "pretest:e2e:v2-console": "pnpm --filter @proto-bridge/local-service build && pnpm build",
    "test:e2e:v2-console": "playwright test e2e/capture-console-v2.spec.ts",
    "pretest:e2e:v2-evidence": "pnpm --filter @proto-bridge/local-service build && pnpm build",
    "test:e2e:v2-evidence": "playwright test e2e/evidence-usability-v2.spec.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@proto-bridge/core": "workspace:*",
    "ajv": "^8.17.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.34",
    "vue-router": "^4.5.1",
    "vuetify": "^3.10.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.10"
  }
}
