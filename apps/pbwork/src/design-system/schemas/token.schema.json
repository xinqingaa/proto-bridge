{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proto-bridge.local/pbwork/schemas/token/v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "category", "defaultValue"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "label": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "color",
        "typography",
        "spacing",
        "sizing",
        "radius",
        "border",
        "elevation",
        "opacity",
        "motion",
        "layout",
        "layer",
        "effect"
      ]
    },
    "defaultValue": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "number" }]
    },
    "description": { "type": "string" }
  }
}
