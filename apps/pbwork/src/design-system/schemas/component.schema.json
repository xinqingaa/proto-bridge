{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proto-bridge.local/pbwork/schemas/component/v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "category",
    "semantic",
    "propsSchema",
    "defaultProps",
    "states",
    "slots",
    "events",
    "tokenBindings",
    "playground"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "category": { "type": "string", "enum": ["basic", "complex"] },
    "semantic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "defaultRole"],
          "properties": {
            "policy": { "const": "fixed" },
            "defaultRole": { "$ref": "#/$defs/semanticRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "defaultRole", "allowedRoles"],
          "properties": {
            "policy": { "const": "contextual" },
            "defaultRole": { "$ref": "#/$defs/semanticRole" },
            "allowedRoles": {
              "type": "array",
              "items": { "$ref": "#/$defs/semanticRole" },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": { "policy": { "const": "decorative" } }
        }
      ]
    },
    "propsSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "object" }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One-line cross-stack behavior description."
    },
    "behavior": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Short interaction / empty / disabled commitments for cross-stack alignment."
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-stack layout intent; never a CSS implementation recipe.",
      "properties": {
        "containerWidth": { "type": "string", "enum": ["fill-parent", "content"] },
        "track": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "itemSizing", "overflow"],
          "properties": {
            "width": { "type": "string", "enum": ["fill-container", "content"] },
            "itemSizing": { "type": "string", "enum": ["content", "equal"] },
            "equalState": { "type": "string", "minLength": 1 },
            "overflow": { "type": "string", "enum": ["horizontal-scroll", "none"] }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownership"],
          "properties": {
            "ownership": { "type": "string", "enum": ["component", "none"] },
            "transition": { "type": "string", "enum": ["horizontal"] }
          }
        }
      }
    },
    "visualAnatomy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-stack material and layer anatomy; never a CSS implementation recipe.",
      "properties": {
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["material", "border", "layering"],
          "properties": {
            "material": { "const": "translucent-glass" },
            "border": { "const": "none" },
            "layering": { "const": "floating" },
            "contour": { "const": "top-transition-arc" }
          }
        }
      }
    },
    "defaultProps": { "type": "object" },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["variant", "interaction", "content"],
            "description": "variant=appearance enum; interaction=loading/disabled; content=empty/closed."
          },
          "props": { "type": "object" }
        }
      }
    },
    "slots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tokenBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      }
    },
    "playground": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation"],
      "properties": {
        "presentation": {
          "type": "string",
          "enum": ["interactive", "gallery", "trigger"],
          "description": "interactive=live scene; gallery=compact state matrix (icon/icon-button only); trigger=overlay via button."
        }
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack"],
      "properties": {
        "pack": { "const": "lucide" },
        "defaults": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "semanticRole": {
      "type": "string",
      "enum": [
        "page",
        "app-bar",
        "bottom-bar",
        "navigation",
        "section",
        "summary",
        "card",
        "list",
        "scroll-list",
        "list-item",
        "filter",
        "search",
        "form",
        "field",
        "tab-bar",
        "tab",
        "tab-panel",
        "tab-viewport",
        "chart",
        "empty-state",
        "loading-state",
        "error-state",
        "sheet",
        "dialog",
        "drawer",
        "toast",
        "button",
        "chip",
        "badge",
        "status",
        "icon",
        "image",
        "text"
      ]
    }
  }
}
