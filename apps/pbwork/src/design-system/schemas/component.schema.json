{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proto-bridge.local/pbwork/schemas/component/v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "category",
    "propsSchema",
    "defaultProps",
    "states",
    "slots",
    "events",
    "tokenBindings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "category": { "type": "string", "enum": ["basic", "complex"] },
    "propsSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "object" }
      }
    },
    "defaultProps": { "type": "object" },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "props": { "type": "object" }
        }
      }
    },
    "slots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tokenBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      }
    }
  }
}
