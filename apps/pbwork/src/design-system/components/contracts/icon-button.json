{
  "schemaVersion": 1,
  "id": "icon-button",
  "category": "basic",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "button"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ariaLabel": {
        "type": "string"
      },
      "icon": {
        "type": "string",
        "enum": [
          "more",
          "plus",
          "search",
          "settings",
          "home",
          "list",
          "user",
          "inbox",
          "check",
          "chevron-down",
          "chevron-right",
          "alert-triangle",
          "alert-circle",
          "clock",
          "refresh-cw",
          "clipboard-check",
          "shield-check",
          "folder-open",
          "thermometer",
          "snowflake",
          "copy",
          "file-text",
          "sliders-horizontal"
        ]
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "tone": {
        "type": "string",
        "enum": [
          "primary",
          "secondary"
        ]
      },
      "variant": {
        "type": "string",
        "enum": [
          "tonal",
          "flat",
          "outlined",
          "text"
        ]
      },
      "loading": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": [
      "ariaLabel"
    ]
  },
  "defaultProps": {
    "ariaLabel": "更多",
    "icon": "more",
    "size": "md",
    "tone": "secondary",
    "variant": "tonal",
    "loading": false,
    "disabled": false
  },
  "states": [
    {
      "id": "primary",
      "label": "主色",
      "props": {
        "tone": "primary"
      }
    },
    {
      "id": "loading",
      "label": "加载",
      "props": {
        "loading": true
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": [
    "click"
  ],
  "tokenBindings": {
    "color": "color.secondary",
    "background": "color.secondary-soft",
    "radius": "radius.full",
    "elevation": "elevation.none",
    "size": "sizing.control-md",
    "target": "sizing.touch",
    "duration": "motion.duration-fast",
    "easing": "motion.easing-standard"
  },
  "playground": {
    "presentation": "single"
  },
  "icons": {
    "pack": "lucide",
    "defaults": [
      "more",
      "plus",
      "search",
      "settings",
      "home",
      "list",
      "user",
      "inbox",
      "check",
      "chevron-down",
      "chevron-right",
      "alert-triangle",
      "alert-circle",
      "clock",
      "refresh-cw",
      "clipboard-check",
      "shield-check",
      "folder-open",
      "thermometer",
      "snowflake",
      "copy",
      "file-text",
      "sliders-horizontal"
    ]
  }
}
