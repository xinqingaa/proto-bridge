{
  "schemaVersion": 1,
  "id": "icon-button",
  "category": "action",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "button"
  },
  "summary": "紧凑图标操作；loading 阻止重复触发，disabled 整体使用 opacity.disabled。",
  "behavior": [
    "ariaLabel 始终说明操作目的",
    "loading 保留操作强调度并阻止重复触发",
    "disabled 阻止激活并使用 opacity.disabled",
    "material=glass 复用共享玻璃材质，与操作类型独立；降低透明度时使用清晰实色表面。"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ariaLabel": {
        "type": "string"
      },
      "icon": {
        "type": "string",
        "enum": [
          "more",
          "plus",
          "search",
          "settings",
          "home",
          "list",
          "user",
          "inbox",
          "check",
          "chevron-down",
          "chevron-left",
          "chevron-right",
          "alert-triangle",
          "alert-circle",
          "clock",
          "refresh-cw",
          "clipboard-check",
          "shield-check",
          "folder-open",
          "thermometer",
          "snowflake",
          "copy",
          "file-text",
          "sliders-horizontal",
          "map-pin",
          "radio",
          "truck",
          "dumbbell",
          "eye",
          "eye-off",
          "footprints",
          "person-standing",
          "sparkles",
          "x",
          "calendar-current",
          "yike-mechanical-calendar",
          "yike-mechanical-focus-high",
          "yike-mechanical-focus-low",
          "yike-mechanical-focus-medium",
          "yike-mode-countdown",
          "yike-mode-pomodoro",
          "yike-mode-stopwatch",
          "yike-sundial-focus-high",
          "yike-sundial-focus-low",
          "yike-sundial-focus-medium",
          "yike-water-focus-high",
          "yike-water-focus-low",
          "yike-water-focus-medium",
          "circle-check",
          "chart-column",
          "book-open",
          "glass-water",
          "leaf",
          "moon",
          "stretch-horizontal"
        ]
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "tone": {
        "type": "string",
        "enum": [
          "primary",
          "secondary"
        ]
      },
      "variant": {
        "type": "string",
        "enum": [
          "tonal",
          "flat",
          "outlined",
          "text"
        ]
      },
      "loading": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      },
      "material": {
        "type": "string",
        "enum": [
          "solid",
          "glass"
        ]
      }
    },
    "required": [
      "ariaLabel"
    ]
  },
  "defaultProps": {
    "ariaLabel": "更多",
    "icon": "more",
    "size": "md",
    "tone": "secondary",
    "variant": "tonal",
    "loading": false,
    "disabled": false,
    "material": "solid"
  },
  "states": [
    {
      "id": "primary",
      "label": "主色",
      "kind": "variant",
      "props": {
        "tone": "primary"
      }
    },
    {
      "id": "loading",
      "label": "加载",
      "kind": "interaction",
      "props": {
        "loading": true
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    },
    {
      "id": "glass",
      "label": "玻璃材质",
      "kind": "variant",
      "props": {
        "material": "glass"
      }
    },
    {
      "id": "glass-loading",
      "label": "玻璃加载",
      "kind": "interaction",
      "props": {
        "material": "glass",
        "loading": true
      }
    },
    {
      "id": "glass-disabled",
      "label": "玻璃禁用",
      "kind": "interaction",
      "props": {
        "material": "glass",
        "disabled": true
      }
    },
    {
      "id": "glass-primary",
      "label": "主色玻璃",
      "kind": "variant",
      "props": {
        "material": "glass",
        "tone": "primary"
      }
    }
  ],
  "slots": [],
  "events": [
    "click"
  ],
  "tokenBindings": {
    "color": "color.secondary",
    "background": "color.secondary-soft",
    "radius": "radius.pill",
    "elevation": "none",
    "size": "size.control",
    "target": "size.touch",
    "duration": "motion.duration-short",
    "easing": "motion.easing-standard",
    "pressedScale": "motion.press-scale-strong",
    "disabledOpacity": "opacity.disabled",
    "glassTint": "color.glass-tint",
    "glassBackdrop": "surface.glass-backdrop",
    "glassEdge": "border.glass",
    "glassLight": "elevation.glass",
    "glassFallback": "color.surface",
    "glassFallbackBorder": "border.default",
    "glassOutline": "border.default",
    "glassForeground": "color.on-surface",
    "glassAccent": "color.primary",
    "glassOnAccent": "color.on-primary",
    "glassPrimaryTint": "icon-button.glass-primary-tint"
  },
  "playground": {
    "presentation": "gallery"
  },
  "icons": {
    "pack": "pbwork",
    "defaults": [
      "more",
      "plus",
      "search",
      "settings",
      "home",
      "list",
      "user",
      "inbox",
      "check",
      "chevron-down",
      "chevron-left",
      "chevron-right",
      "alert-triangle",
      "alert-circle",
      "clock",
      "refresh-cw",
      "clipboard-check",
      "shield-check",
      "folder-open",
      "thermometer",
      "snowflake",
      "copy",
      "file-text",
      "sliders-horizontal",
      "map-pin",
      "radio",
      "truck",
      "dumbbell",
      "eye",
      "eye-off",
      "footprints",
      "person-standing",
      "sparkles",
      "x"
    ],
    "artwork": "_shared/glyph-artwork.json"
  },
  "componentTokens": {
    "glass-primary-tint": {
      "valueType": "color",
      "default": "{color.primary}",
      "modeVariant": true,
      "bindable": true,
      "label": "主要操作玻璃底色"
    }
  }
}
