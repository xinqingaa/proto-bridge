{
  "schemaVersion": 1,
  "id": "icon-button",
  "category": "action",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "button"
  },
  "summary": "紧凑图标操作；loading 阻止重复触发，disabled 整体使用 opacity.disabled。",
  "behavior": [
    "ariaLabel 始终说明操作目的",
    "loading 保留操作强调度并阻止重复触发",
    "disabled 阻止激活并使用 opacity.disabled"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ariaLabel": {
        "type": "string"
      },
      "icon": {
        "type": "string",
        "enum": [
          "more",
          "plus",
          "search",
          "settings",
          "home",
          "list",
          "user",
          "inbox",
          "check",
          "chevron-down",
          "chevron-left",
          "chevron-right",
          "alert-triangle",
          "alert-circle",
          "clock",
          "refresh-cw",
          "clipboard-check",
          "shield-check",
          "folder-open",
          "thermometer",
          "snowflake",
          "copy",
          "file-text",
          "sliders-horizontal",
          "map-pin",
          "radio",
          "truck",
          "dumbbell",
          "eye",
          "eye-off",
          "footprints",
          "person-standing",
          "sparkles",
          "x"
        ]
      },
      "size": {
        "type": "string",
        "enum": ["sm", "md", "lg"]
      },
      "tone": {
        "type": "string",
        "enum": ["primary", "secondary"]
      },
      "variant": {
        "type": "string",
        "enum": ["tonal", "flat", "outlined", "text"]
      },
      "loading": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": ["ariaLabel"]
  },
  "defaultProps": {
    "ariaLabel": "更多",
    "icon": "more",
    "size": "md",
    "tone": "secondary",
    "variant": "tonal",
    "loading": false,
    "disabled": false
  },
  "states": [
    {
      "id": "primary",
      "label": "主色",
      "kind": "variant",
      "props": {
        "tone": "primary"
      }
    },
    {
      "id": "loading",
      "label": "加载",
      "kind": "interaction",
      "props": {
        "loading": true
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": ["click"],
  "tokenBindings": {
    "color": "color.secondary",
    "background": "color.secondary-soft",
    "radius": "radius.full",
    "elevation": "elevation.none",
    "size": "sizing.control-md",
    "target": "sizing.touch",
    "duration": "motion.duration-fast",
    "easing": "motion.easing-standard",
    "pressedScale": "motion.scale-pressed-strong",
    "disabledOpacity": "opacity.disabled"
  },
  "playground": {
    "presentation": "gallery"
  },
  "icons": {
    "pack": "lucide",
    "defaults": [
      "more",
      "plus",
      "search",
      "settings",
      "home",
      "list",
      "user",
      "inbox",
      "check",
      "chevron-down",
      "chevron-left",
      "chevron-right",
      "alert-triangle",
      "alert-circle",
      "clock",
      "refresh-cw",
      "clipboard-check",
      "shield-check",
      "folder-open",
      "thermometer",
      "snowflake",
      "copy",
      "file-text",
      "sliders-horizontal",
      "map-pin",
      "radio",
      "truck",
      "dumbbell",
      "eye",
      "eye-off",
      "footprints",
      "person-standing",
      "sparkles",
      "x"
    ]
  }
}
