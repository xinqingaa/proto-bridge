{
  "schemaVersion": 1,
  "id": "secondary-tabs",
  "category": "complex",
  "semantic": { "policy": "fixed", "defaultRole": "tab-bar" },
  "summary": "二级页内分区：文字下方朝上的居中小三角标出当前视图。",
  "behavior": [
    "选中态只使用中性激活色、600 字重及与文字中心对齐、朝上的小三角；不使用宽滑线或极简替代样式",
    "轨道填满组件容器而非视口；默认项按内容宽排列，equal 状态才平分轨道，项过多时横向滚动",
    "点击无 ripple；内容以与一级 Tab 一致的水平过渡切换，可按场景启用触摸或鼠标横滑",
    "分段筛选使用三级 Tab，不使用本组件"
  ],
  "layout": {
    "containerWidth": "fill-parent",
    "track": {
      "width": "fill-container",
      "itemSizing": "content",
      "equalState": "equal",
      "overflow": "horizontal-scroll"
    },
    "viewport": { "ownership": "component", "transition": "horizontal" }
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": { "type": "string" },
      "showDivider": { "type": "boolean" },
      "grow": { "type": "boolean" },
      "align": { "type": "string", "enum": ["start", "center"] },
      "size": { "type": "string", "enum": ["sm", "md", "lg"] },
      "swipe": { "type": "boolean" },
      "mouseSwipe": { "type": "boolean" },
      "fill": { "type": "boolean" },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "label"],
          "properties": {
            "value": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "required": ["items"]
  },
  "defaultProps": {
    "modelValue": "overview",
    "showDivider": false,
    "grow": false,
    "align": "start",
    "size": "md",
    "swipe": true,
    "mouseSwipe": true,
    "fill": false,
    "items": [
      { "value": "overview", "label": "概览" },
      { "value": "activity", "label": "活动" },
      { "value": "records", "label": "记录" },
      { "value": "attachments", "label": "附件" }
    ]
  },
  "states": [
    {
      "id": "equal",
      "label": "等宽",
      "kind": "variant",
      "props": { "grow": true }
    }
  ],
  "slots": ["overview", "activity", "records", "attachments"],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "indicator": "color.section-tab-active",
    "active": "color.section-tab-active",
    "inactive": "color.on-surface-muted",
    "border": "border.hairline",
    "radius": "radius.md",
    "height": "sizing.control-md",
    "target": "sizing.touch",
    "typography": "typography.label",
    "panel": "typography.caption",
    "duration": "motion.duration-slow",
    "easing": "motion.easing-standard"
  },
  "playground": { "presentation": "interactive" }
}
