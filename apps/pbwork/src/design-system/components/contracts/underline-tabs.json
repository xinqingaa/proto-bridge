{
  "schemaVersion": 1,
  "id": "underline-tabs",
  "category": "complex",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "tab-bar"
  },
  "summary": "页内分区导航：滑线指示选中，或极简纯文字样式。",
  "behavior": [
    "variant=underline 默认显示底部滑线；variant=minimal 无滑线、仅文字强调",
    "内容必须进具名 slot；短内容可滑用 fill",
    "swipe / mouseSwipe 分离，不可互兜底",
    "分段 pill 筛选请用 tabs，不要用本组件"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "variant": {
        "type": "string",
        "enum": [
          "underline",
          "minimal"
        ]
      },
      "showIndicator": {
        "type": "boolean"
      },
      "showDivider": {
        "type": "boolean"
      },
      "grow": {
        "type": "boolean"
      },
      "align": {
        "type": "string",
        "enum": [
          "start",
          "center"
        ]
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "swipe": {
        "type": "boolean"
      },
      "mouseSwipe": {
        "type": "boolean"
      },
      "fill": {
        "type": "boolean"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "required": [
      "items"
    ]
  },
  "defaultProps": {
    "modelValue": "overview",
    "variant": "underline",
    "showIndicator": true,
    "showDivider": false,
    "grow": false,
    "align": "start",
    "size": "md",
    "swipe": true,
    "mouseSwipe": true,
    "fill": false,
    "items": [
      {
        "value": "overview",
        "label": "概览"
      },
      {
        "value": "activity",
        "label": "活动"
      }
    ]
  },
  "states": [
    {
      "id": "minimal",
      "label": "极简",
      "kind": "variant",
      "props": {
        "variant": "minimal",
        "showIndicator": false
      }
    },
    {
      "id": "equal",
      "label": "等宽",
      "kind": "variant",
      "props": {
        "grow": true
      }
    }
  ],
  "slots": [
    "overview",
    "activity"
  ],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "indicator": "color.primary",
    "activeBackground": "transparent",
    "activeColor": "color.primary",
    "inactiveColor": "color.on-surface-muted",
    "border": "border.hairline",
    "radius": "radius.md",
    "height": "sizing.control-md",
    "target": "sizing.touch",
    "typography": "typography.label",
    "panel": "typography.caption",
    "duration": "motion.duration-slow",
    "easing": "motion.easing-standard"
  },
  "playground": {
    "presentation": "single"
  }
}
