    "action"
  ],
  "events": [
    "action"
  ],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "title": "color.on-surface",
    "description": "color.on-surface-muted",
    "required": "color.error",
    "radius": "radius.lg",
    "gap": "spacing.sm-plus",
