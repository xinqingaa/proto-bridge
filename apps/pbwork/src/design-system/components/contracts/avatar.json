{
  "schemaVersion": 1,
  "id": "avatar",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "image"
  },
  "summary": "以头像图片或稳定首字母表示人员与主体，尺寸只使用受控语义档位。",
  "behavior": [
    "没有图片时从 name 生成稳定首字母，不把随机图像作为默认内容",
    "sm、md、lg 只改变受控尺寸，不改变主体身份"
  ],
  "propsSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "tone": {
        "type": "string",
        "enum": [
          "primary",
          "secondary"
        ]
      }
    },
    "required": [
      "name"
    ]
  },
  "defaultProps": {
    "name": "李明",
    "size": "md",
    "tone": "primary"
  },
  "states": [
    {
      "id": "small",
      "label": "小尺寸",
      "kind": "variant",
      "props": {
        "size": "sm"
      }
    },
    {
      "id": "large",
      "label": "大尺寸",
      "kind": "variant",
      "props": {
        "size": "lg"
      }
    }
  ],
  "slots": [],
  "events": [],
  "tokenBindings": {
    "background": "color.primary",
    "text": "color.on-primary",
    "size": "sizing.avatar-md",
    "radius": "radius.full",
    "initials": "typography.label"
  },
  "playground": {
    "presentation": "interactive"
  }
}
