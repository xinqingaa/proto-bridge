{
  "schemaVersion": 1,
  "id": "badge",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "badge"
  },
  "summary": "只读数量、状态或严重度徽标；不承担选择与提交交互。",
  "behavior": [
    "tone 只表达受控状态语义，不把 Badge 变成可点击 Chip",
    "短标签保持单一状态含义，复杂说明由调用方另行组织"
  ],
  "propsSchema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string"
      },
      "tone": {
        "type": "string",
        "enum": [
          "primary",
          "error",
          "success",
          "warning"
        ]
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "3",
    "tone": "error"
  },
  "states": [
    {
      "id": "success",
      "label": "成功",
      "kind": "variant",
      "props": {
        "label": "完成",
        "tone": "success"
      }
    },
    {
      "id": "warning",
      "label": "警告",
      "kind": "variant",
      "props": {
        "label": "超时",
        "tone": "warning"
      }
    }
  ],
  "slots": [],
  "events": [],
  "tokenBindings": {
    "background": "color.error",
    "text": "color.on-error",
    "radius": "radius.full",
    "label": "typography.caption-strong"
  },
  "playground": {
    "presentation": "interactive"
  }
}
