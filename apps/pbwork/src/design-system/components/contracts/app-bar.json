{
  "schemaVersion": 1,
  "id": "app-bar",
  "category": "navigation",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "app-bar"
  },
  "summary": "页面或栈级顶部栏；统一承载标题、返回动作和一个可选尾部操作。",
  "behavior": [
    "showBack 控制返回入口，触发 back 事件但不自行决定路由",
    "空标题不渲染标题节点，避免与内容区大标题重复",
    "尾部操作必须具有可访问名称，并通过 action 事件交给页面处理"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string"
      },
      "dense": {
        "type": "boolean"
      },
      "elevated": {
        "type": "boolean"
      },
      "showBack": {
        "type": "boolean"
      },
      "backLabel": {
        "type": "string"
      },
      "showAction": {
        "type": "boolean"
      },
      "actionIcon": {
        "type": "string",
        "enum": [
          "more",
          "plus",
          "search",
          "settings"
        ]
      },
      "actionLabel": {
        "type": "string",
        "description": "无障碍名称；未传时按 actionIcon 推导"
      }
    },
    "required": [
      "title"
    ]
  },
  "defaultProps": {
    "title": "项目协作",
    "dense": false,
    "elevated": false,
    "showBack": true,
    "backLabel": "返回",
    "showAction": true,
    "actionIcon": "more",
    "actionLabel": "更多操作"
  },
  "states": [
    {
      "id": "no-back",
      "label": "无返回",
      "kind": "content",
      "props": {
        "showBack": false
      }
    }
  ],
  "slots": [
    "append"
  ],
  "events": [
    "back",
    "action"
  ],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "text": "color.on-surface",
    "elevation": "elevation.card",
    "title": "typography.subtitle",
    "padding": "spacing.md",
    "safeInsetFallback": "spacing.none",
    "restingElevation": "elevation.none",
    "iconSize": "sizing.icon-md"
  },
  "playground": {
    "presentation": "interactive"
  }
}
