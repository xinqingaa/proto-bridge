{
  "schemaVersion": 1,
  "id": "app-bar",
  "category": "complex",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "app-bar"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string"
      },
      "dense": {
        "type": "boolean"
      },
      "elevated": {
        "type": "boolean"
      },
      "showBack": {
        "type": "boolean"
      },
      "backLabel": {
        "type": "string"
      },
      "showAction": {
        "type": "boolean"
      },
      "actionIcon": {
        "type": "string",
        "enum": ["more", "plus", "search", "settings"]
      },
      "actionLabel": {
        "type": "string",
        "description": "无障碍名称；未传时按 actionIcon 推导"
      }
    },
    "required": ["title"]
  },
  "defaultProps": {
    "title": "项目协作",
    "dense": false,
    "elevated": false,
    "showBack": true,
    "backLabel": "返回",
    "showAction": true,
    "actionIcon": "more",
    "actionLabel": "更多操作"
  },
  "states": [
    {
      "id": "no-back",
      "label": "无返回",
      "props": {
        "showBack": false
      }
    }
  ],
  "slots": ["append"],
  "events": ["back", "action"],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "text": "color.on-surface",
    "elevation": "elevation.card",
    "title": "typography.subtitle"
  },
  "playground": {
    "presentation": "interactive"
  }
}
