{
  "schemaVersion": 1,
  "id": "app-bar",
  "category": "navigation",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "app-bar"
  },
  "summary": "页面或栈级顶部栏；统一承载标题、返回动作和一个可选尾部操作。",
  "behavior": [
    "showBack 控制返回入口，触发 back 事件但不自行决定路由",
    "空标题不渲染标题节点，避免与内容区大标题重复",
    "尾部操作必须具有可访问名称，并通过 action 事件交给页面处理"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string"
      },
      "dense": {
        "type": "boolean"
      },
      "elevated": {
        "type": "boolean"
      },
      "showBack": {
        "type": "boolean"
      },
      "backLabel": {
        "type": "string"
      },
      "showAction": {
        "type": "boolean"
      },
      "actionIcon": {
        "type": "string",
        "enum": ["more", "plus", "search", "settings"]
      },
      "actionLabel": {
        "type": "string",
        "description": "无障碍名称；未传时按 actionIcon 推导"
      },
      "background": {
        "type": "string",
        "enum": ["theme", "solid", "glass", "transparent"]
      }
    },
    "required": ["title"]
  },
  "defaultProps": {
    "title": "项目协作",
    "dense": false,
    "elevated": false,
    "showBack": true,
    "backLabel": "返回",
    "showAction": true,
    "actionIcon": "more",
    "actionLabel": "更多操作",
    "background": "theme"
  },
  "states": [
    {
      "id": "no-back",
      "label": "无返回",
      "kind": "content",
      "props": {
        "showBack": false
      }
    },
    {
      "id": "glass",
      "label": "玻璃背景",
      "kind": "variant",
      "props": {
        "background": "glass"
      }
    },
    {
      "id": "transparent",
      "label": "透明背景",
      "kind": "variant",
      "props": {
        "background": "transparent"
      }
    }
  ],
  "slots": ["append"],
  "events": ["back", "action"],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "text": "color.on-surface",
    "elevation": "elevation.surface",
    "title": "typography.subtitle",
    "padding": "spacing.md",
    "restingElevation": "none",
    "iconSize": "size.icon",
    "materialOpacity": "opacity.translucent",
    "materialBackdrop": "surface.glass-backdrop",
    "materialBorder": "border.default",
    "titleInset": "spacing.xs",
    "glassTint": "color.glass-tint",
    "glassClear": "color.glass-clear",
    "glassEdge": "border.glass",
    "glassLight": "elevation.glass",
    "glassFallback": "color.surface",
    "glassFallbackBorder": "border.default",
    "lineHeight": "size.navigation-bar",
    "touch": "size.touch",
    "focus": "border.focus",
    "focusRadius": "radius.control",
    "lineGap": "spacing.sm"
  },
  "playground": {
    "presentation": "interactive"
  },
  "componentTokens": {
    "surface-treatment": {
      "valueType": "enum",
      "default": "{surface.treatment}",
      "modeVariant": false,
      "enumValues": ["solid", "outlined", "glass"],
      "bindable": false
    }
  },
  "visualAnatomy": {
    "summary": " 玻璃表面采用统一透明底色、边缘与内外光影。"
  },
  "layout": {
    "summary": "两侧等分空间承托居中单行标题，超长时截断。背景仅允许 theme/solid/glass/transparent。"
  }
}
