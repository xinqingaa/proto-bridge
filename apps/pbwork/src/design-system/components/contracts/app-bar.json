{
  "schemaVersion": 1,
  "id": "app-bar",
  "category": "complex",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string" },
      "dense": { "type": "boolean" },
      "elevated": { "type": "boolean" },
      "showBack": { "type": "boolean" },
      "backLabel": { "type": "string" },
      "showAction": { "type": "boolean" },
      "actionLabel": { "type": "string" }
    },
    "required": ["title"]
  },
  "defaultProps": {
    "title": "项目协作",
    "dense": false,
    "elevated": false,
    "showBack": true,
    "backLabel": "返回",
    "showAction": true,
    "actionLabel": "更多操作"
  },
  "states": [
    { "id": "no-back", "label": "无返回", "props": { "showBack": false } }
  ],
  "slots": ["append"],
  "events": ["back", "action"],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "elevation": "elevation.card",
    "title": "typography.subtitle"
  }
}
