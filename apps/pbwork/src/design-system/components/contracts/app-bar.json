{
  "schemaVersion": 1,
  "id": "app-bar",
  "category": "complex",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string" },
      "dense": { "type": "boolean" },
      "elevated": { "type": "boolean" },
      "showBack": { "type": "boolean" },
      "backLabel": { "type": "string" }
    },
    "required": ["title"]
  },
  "defaultProps": { "title": "项目协作", "dense": false, "elevated": false, "showBack": false, "backLabel": "返回" },
  "states": [],
  "slots": ["append"],
  "events": ["back"],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "elevation": "elevation.card",
    "title": "typography.subtitle"
  }
}
