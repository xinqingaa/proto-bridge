{
  "schemaVersion": 1,
  "id": "duration-picker",
  "category": "input",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "field"
  },
  "summary": "一至三列通用滚轮；每列的选项、单位和显示文本由调用方提供。",
  "behavior": [
    "columns 提供一至三列独立选项，modelValue 按列顺序回传选中值；不包含时长、时刻或范围换算逻辑",
    "使用原生纵滚与 scroll snap；点击、上下键与 Home/End 等价，禁用时阻止提交",
    "外部更新同步各列位置；各列使用稳定 id，单位与中央选中行对齐"
  ],
  "layout": {
    "summary": "One to three equal-width columns with centered selection bands and independent native vertical snapping."
  },
  "visualAnatomy": {
    "summary": "等宽列、中央选择带与单位；数字与文本支持各自字形。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "columns": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": [
            "id",
            "label",
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "numeric": {
              "type": "boolean"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "modelValue": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": [
      "columns"
    ]
  },
  "defaultProps": {
    "label": "双列选择",
    "columns": [
      {
        "id": "first",
        "label": "第一列",
        "unit": "项",
        "numeric": true,
        "options": [
          {
            "value": 0,
            "label": "0"
          },
          {
            "value": 1,
            "label": "1"
          },
          {
            "value": 2,
            "label": "2"
          },
          {
            "value": 3,
            "label": "3"
          }
        ]
      },
      {
        "id": "second",
        "label": "第二列",
        "unit": "项",
        "numeric": true,
        "options": [
          {
            "value": 0,
            "label": "0"
          },
          {
            "value": 1,
            "label": "1"
          },
          {
            "value": 2,
            "label": "2"
          },
          {
            "value": 3,
            "label": "3"
          },
          {
            "value": 4,
            "label": "4"
          },
          {
            "value": 5,
            "label": "5"
          }
        ]
      }
    ],
    "modelValue": [
      1,
      2
    ],
    "disabled": false
  },
  "states": [
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "color": "color.on-surface",
    "muted": "color.on-surface-muted",
    "gap": "spacing.sm",
    "typography": "typography.content",
    "selection": "color.surface",
    "track": "color.surface",
    "radius": "radius.control",
    "padding": "spacing.xs",
    "focus": "border.focus",
    "disabledOpacity": "opacity.disabled",
    "number": "typography.numeric-content",
    "row": "size.control",
    "settleDuration": "motion.duration-short",
    "surface": "color.surface",
    "surfaceRadius": "radius.surface",
    "selectionRadius": "radius.control-compact",
    "unit": "typography.caption",
    "selectedFont": "typography.numeric-title",
    "textSelectedFont": "typography.subtitle"
  },
  "playground": {
    "presentation": "interactive"
  }
}
