{
  "schemaVersion": 1,
  "id": "metric",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "summary"
  },
  "summary": "数字、单位、说明与变化量的只读指标。",
  "behavior": [
    "变化以正负文字和颜色共同表达，零为持平；省略 change 时不渲染变化",
    "指标不假设上涨必然是好事；业务可在外层解释统计口径"
  ],
  "layout": {
    "summary": "数字、单位、说明与变化量的只读指标。"
  },
  "visualAnatomy": {
    "summary": "使用当前主题的语义色、字阶、间距和受控形状，不在实例上换绑。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "value": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "unit": {
        "type": "string"
      },
      "change": {
        "type": "number"
      }
    }
  },
  "defaultProps": {
    "label": "本周完成",
    "value": 24,
    "unit": "次"
  },
  "states": [
    {
      "id": "decrease",
      "label": "下降",
      "kind": "content",
      "props": {
        "change": -8
      }
    },
    {
      "id": "unchanged",
      "label": "持平",
      "kind": "content",
      "props": {
        "change": 0
      }
    }
  ],
  "slots": [],
  "events": [],
  "tokenBindings": {
    "color": "color.on-surface",
    "muted": "color.on-surface-muted",
    "gap": "spacing.sm",
    "value": "typography.numeric-display",
    "caption": "typography.caption",
    "positive": "color.success",
    "negative": "color.error"
  },
  "playground": {
    "presentation": "interactive"
  }
}
