{
  "schemaVersion": 1,
  "id": "brand-mark",
  "category": "navigation",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "image"
  },
  "summary": "主题品牌图形与可替换品牌插槽，无资源时退回名称。",
  "behavior": [
    "资产按解析后的拥有包查找 URL，不按模式分支隐藏语义节点",
    "无资源时显示 name；公开 mark / wordmark 插槽允许原型自有品牌形态"
  ],
  "layout": {
    "summary": "主题品牌图形与可替换品牌插槽，无资源时退回名称。"
  },
  "visualAnatomy": {
    "summary": "真实图形与字标支持横向或纵向组合，无资源退回名称；不内置业务品牌。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string"
      },
      "layout": {
        "type": "string",
        "enum": [
          "inline",
          "stacked"
        ]
      }
    }
  },
  "defaultProps": {
    "name": "品牌",
    "layout": "inline"
  },
  "states": [
    {
      "id": "named",
      "label": "名称",
      "kind": "content",
      "props": {
        "name": "专注每一刻"
      }
    },
    {
      "id": "compact",
      "label": "短名称",
      "kind": "content",
      "props": {
        "name": "PB"
      }
    },
    {
      "id": "stacked",
      "label": "纵向组合",
      "kind": "variant",
      "props": {
        "layout": "stacked"
      }
    }
  ],
  "slots": [
    "mark",
    "wordmark"
  ],
  "events": [],
  "tokenBindings": {
    "color": "color.on-surface",
    "gap": "spacing.sm",
    "typography": "typography.title-lg",
    "mark": "asset.brand-mark",
    "wordmark": "asset.brand-wordmark",
    "size": "size.brand"
  },
  "playground": {
    "presentation": "interactive"
  }
}
