{
  "schemaVersion": 1,
  "id": "bottom-sheet",
  "category": "feedback",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "sheet"
  },
  "summary": "从底部覆盖当前页面的半屏操作容器；保持独立 Sheet 外壳与关闭边界。",
  "behavior": [
    "打开时挂载 scrim、dialog 语义和顶部关闭 Icon Button",
    "modelValue 关闭后恢复下层交互；决策按钮放在 actions 槽，一颗主要类型占满，两颗时左次要右主要并等分撑满"
  ],
  "layout": {
    "summary": "Sheet 从视口底部抬起，内容高度受上限约束；标题区与内容区由同一滚动边界承载。"
  },
  "visualAnatomy": {
    "summary": "scrim 位于页面内容之上、Sheet 表面之下；顶栏为居中标题与关闭 Icon Button，Sheet 使用顶部圆角、边框与 raised elevation。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string"
      },
      "modelValue": {
        "type": "boolean"
      }
    },
    "required": [
      "title"
    ]
  },
  "defaultProps": {
    "title": "操作面板",
    "modelValue": false
  },
  "states": [
    {
      "id": "open",
      "label": "打开",
      "kind": "content",
      "props": {
        "modelValue": true
      }
    },
    {
      "id": "closed",
      "label": "关闭",
      "kind": "content",
      "props": {
        "modelValue": false
      }
    }
  ],
  "slots": [
    "default",
    "actions"
  ],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "radius": "radius.lg",
    "elevation": "elevation.raised",
    "title": "typography.subtitle",
    "body": "typography.content",
    "padding": "spacing.md",
    "headerControl": "sizing.touch",
    "fill": "layout.fill",
    "flexFill": "layout.flex-fill"
  },
  "playground": {
    "presentation": "trigger"
  }
}
