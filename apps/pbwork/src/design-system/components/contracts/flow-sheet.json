{
  "schemaVersion": 1,
  "id": "flow-sheet",
  "category": "feedback",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "sheet"
  },
  "summary": "在同一张底部 Sheet 内承载连续多步操作，并保持当前步骤与相邻页面裁剪。",
  "behavior": [
    "step 是受控的零基索引，切换后通过 update:step 回传当前步骤",
    "swipe 开启时允许横向切步，当前步骤以整页宽度平移进入视口，拖拽时跟手、松手后完成切页",
    "右上角使用带可访问名称的 X 图标关闭整张 Sheet；step > 0 时左上角提供返回上一屏",
    "关闭只更新 modelValue，返回只更新 step，不替业务流程决定提交、取消或路由",
    "material=solid保留实色表面，glass复用共享玻璃材质及实色降级；材质不改变关闭、焦点、滚动或步骤机制。"
  ],
  "layout": {
    "summary": "Sheet 内部只有一个裁剪视口；各步骤等宽横排，当前 step 以整页宽度平移进入视口。"
  },
  "visualAnatomy": {
    "summary": "复用 BottomSheet 的 scrim 与 raised surface；顶栏为返回/标题/关闭且与主体无分割线，另有步骤指示、步骤视口和操作区。操作区一颗主要类型占满，两颗时等分撑满。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string"
      },
      "modelValue": {
        "type": "boolean"
      },
      "step": {
        "type": "number"
      },
      "stepCount": {
        "type": "number"
      },
      "swipe": {
        "type": "boolean"
      },
      "material": {
        "type": "string",
        "enum": [
          "solid",
          "glass"
        ]
      }
    },
    "required": [
      "title"
    ]
  },
  "defaultProps": {
    "title": "分步面板",
    "modelValue": false,
    "step": 0,
    "stepCount": 3,
    "swipe": true,
    "material": "solid"
  },
  "states": [
    {
      "id": "step-one",
      "label": "第一步",
      "kind": "content",
      "props": {
        "modelValue": true,
        "step": 0,
        "stepCount": 3
      }
    },
    {
      "id": "step-two",
      "label": "第二步",
      "kind": "content",
      "props": {
        "modelValue": true,
        "step": 1,
        "stepCount": 3
      }
    },
    {
      "id": "glass",
      "label": "玻璃面板",
      "kind": "variant",
      "props": {
        "modelValue": true,
        "material": "glass"
      }
    }
  ],
  "slots": [
    "default",
    "actions"
  ],
  "events": [
    "update:modelValue",
    "update:step"
  ],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "description": "color.on-surface-muted",
    "inactiveIndicator": "color.outline",
    "activeIndicator": "color.primary",
    "radius": "radius.surface",
    "elevation": "elevation.raised",
    "title": "typography.subtitle",
    "body": "typography.content",
    "stepLabel": "typography.micro",
    "headerGap": "spacing.sm-plus",
    "headerControl": "size.touch",
    "dotGap": "flow-sheet.gap",
    "dotSize": "size.marker",
    "duration": "flow-sheet.duration",
    "easing": "motion.easing-gentle",
    "glassTint": "color.glass-tint",
    "glassEdge": "border.glass",
    "glassLight": "elevation.glass",
    "glassBackdrop": "surface.glass-backdrop",
    "glassFallback": "color.surface",
    "glassFallbackBorder": "border.default"
  },
  "playground": {
    "presentation": "trigger"
  },
  "componentTokens": {
    "gap": {
      "valueType": "length",
      "default": "{space.6}",
      "modeVariant": false,
      "bindable": true
    },
    "duration": {
      "valueType": "duration",
      "default": 220,
      "modeVariant": false,
      "bindable": true
    }
  }
}
