{
  "schemaVersion": 1,
  "id": "heatmap",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "chart"
  },
  "summary": "按周分列的日强度图，以日期保持稳定身份。",
  "behavior": [
    "以 UTC 日期补齐中间日期并按周一到周日排列，单次最多展示 366 天",
    "缺失日期不伪装为观测到的零值；日期与原始值用可访问名称说明",
    "点击或键盘选择日期只发出受控值，颜色之外保留数值文本"
  ],
  "layout": {
    "summary": "Monday-first seven-cell columns, chronological weeks in one contained horizontal scroll area; missing days occupy cells."
  },
  "visualAnatomy": {
    "summary": "Three finite intensity colors, observed zero neutral surface, missing recessed surface; selected cell has focus outline and date text."
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "days": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          },
          "required": ["date", "value"]
        }
      },
      "modelValue": {
        "type": "string"
      }
    }
  },
