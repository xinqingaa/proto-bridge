{
  "schemaVersion": 1,
  "id": "heatmap",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "chart"
  },
  "summary": "按周分列的日强度图，以日期保持稳定身份。",
  "behavior": [
    "以 UTC 日期补齐中间日期并按周一到周日排列，单次最多展示 366 天",
    "缺失日期不伪装为观测到的零值；日期与原始值用可访问名称说明",
    "点击或键盘选择日期只发出受控值，颜色之外保留数值文本",
    "readonly=true 时日期为非交互标记，不发出选择事件、不显示选择提示；默认仍为交互模式。",
    "plot 插槽仅在 readonly 模式生效，接收公共日期算法生成的 weeks 与 max；调用方负责图形、等价文本和 Token Evidence，不得添加日期选择机制。",
    "dayLabels 提供日期的可访问业务说明，legend 插槽替换强度图例。"
  ],
  "layout": {
    "summary": "Monday-first seven-cell columns, chronological weeks in one contained horizontal scroll area; missing days occupy cells."
  },
  "visualAnatomy": {
    "summary": "按周排列的日期强度图，提供月份、星期、强度图例和选中日期的实际值。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "days": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "date",
            "value"
          ]
        }
      },
      "modelValue": {
        "type": "string"
      },
      "readonly": {
        "type": "boolean"
      },
      "dayLabels": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
