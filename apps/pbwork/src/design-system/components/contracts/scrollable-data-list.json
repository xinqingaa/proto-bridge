{
  "schemaVersion": 1,
  "id": "scrollable-data-list",
  "category": "complex",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "scroll-list"
  },
  "summary": "滚动壳；disabled 关闭刷新、加载和鼠标拖滚，并使用 opacity.disabled。",
  "behavior": ["disabled 时不触发刷新或加载更多，整体使用 opacity.disabled"],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pullRefresh": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "threshold": {
                "type": "number",
                "minimum": 1
              },
              "maxDistance": {
                "type": "number",
                "minimum": 1
              },
              "mouse": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "loadMore": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "rootMargin": {
                "type": "string"
              },
              "manualFallback": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "dragScroll": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mouse": {
                "type": "boolean"
              },
              "momentum": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "refreshing": {
        "type": "boolean"
      },
      "loadingMore": {
        "type": "boolean"
      },
      "hasMore": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      }
    }
  },
  "defaultProps": {
    "pullRefresh": true,
    "loadMore": true,
    "dragScroll": false,
    "refreshing": false,
    "loadingMore": false,
    "hasMore": true,
    "disabled": false
  },
  "states": [
    {
      "id": "refreshing",
      "label": "刷新中",
      "props": {
        "refreshing": true
      }
    },
    {
      "id": "loading-more",
      "label": "加载更多",
      "props": {
        "loadingMore": true
      }
    },
    {
      "id": "complete",
      "label": "没有更多",
      "props": {
        "hasMore": false
      }
    },
    {
      "id": "disabled",
      "label": "禁用交互",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": ["default", "refresh-indicator", "load-footer", "no-more"],
  "events": ["refresh", "load-more"],
  "tokenBindings": {
    "background": "color.background",
    "primary": "color.primary",
    "muted": "color.on-surface-muted",
    "footer": "typography.caption",
    "duration": "motion.duration-normal",
    "disabledOpacity": "opacity.disabled"
  },
  "playground": {
    "presentation": "interactive"
  }
}
