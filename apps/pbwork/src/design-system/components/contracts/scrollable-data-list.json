{
  "schemaVersion": 1,
  "id": "scrollable-data-list",
  "category": "complex",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "scroll-list"
  },
  "summary": "滚动壳；disabled 关闭刷新、加载和鼠标拖滚，并使用 opacity.disabled。",
  "behavior": ["disabled 时不触发刷新或加载更多，整体使用 opacity.disabled"],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pullRefresh": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mouse": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "loadMore": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "manualFallback": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "dragScroll": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mouse": {
                "type": "boolean"
              },
              "momentum": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "refreshing": {
        "type": "boolean"
      },
      "loadingMore": {
        "type": "boolean"
      },
      "hasMore": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      }
    }
  },
  "defaultProps": {
    "pullRefresh": true,
    "loadMore": true,
    "dragScroll": false,
    "refreshing": false,
    "loadingMore": false,
    "hasMore": true,
    "disabled": false
  },
  "states": [
    {
      "id": "refreshing",
      "label": "刷新中",
      "props": {
        "refreshing": true
      }
    },
    {
      "id": "loading-more",
      "label": "加载更多",
      "props": {
        "loadingMore": true
      }
    },
    {
      "id": "complete",
      "label": "没有更多",
      "props": {
        "hasMore": false
      }
    },
    {
      "id": "disabled",
      "label": "禁用交互",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": ["default", "refresh-indicator", "load-footer", "no-more"],
  "events": ["refresh", "load-more"],
  "tokenBindings": {
    "background": "color.background",
    "primary": "color.primary",
    "muted": "color.on-surface-muted",
    "footer": "typography.caption",
    "duration": "motion.duration-normal",
    "easing": "motion.easing-gentle",
    "disabledOpacity": "opacity.disabled",
    "hiddenOpacity": "opacity.hidden",
    "visibleOpacity": "opacity.visible",
    "refreshTarget": "sizing.touch",
    "footerHeight": "sizing.control-lg",
    "actionMinWidth": "sizing.refresh-action-min-width",
    "actionHeight": "sizing.refresh-action-height",
    "fill": "layout.fill",
    "refreshTranslation": "layout.translate-full-negative",
    "loadMoreRootMargin": "layout.load-more-root-margin",
    "refreshThreshold": "layout.pull-refresh-threshold",
    "refreshMaxDistance": "layout.pull-refresh-max-distance",
    "refreshRestingDistance": "sizing.control-lg",
    "sentinel": "border.width-hairline"
  },
  "playground": {
    "presentation": "interactive"
  }
}
