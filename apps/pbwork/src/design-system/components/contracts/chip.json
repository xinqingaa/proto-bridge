{
  "schemaVersion": 1,
  "id": "chip",
  "category": "basic",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": { "type": "string" },
      "tone": {
        "type": "string",
        "enum": ["primary", "secondary", "success", "warning", "error"]
      },
      "radius": {
        "type": "string",
        "enum": ["sm", "md", "lg", "full"]
      },
      "elevated": { "type": "boolean" }
    },
    "required": ["label"]
  },
  "defaultProps": {
    "label": "进行中",
    "tone": "primary",
    "radius": "full",
    "elevated": false
  },
  "states": [],
  "slots": ["default"],
  "events": [],
  "tokenBindings": {
    "background": "color.primary-soft",
    "color": "color.primary",
    "radius": "radius.full",
    "elevation": "elevation.card",
    "typography": "typography.caption"
  }
}
