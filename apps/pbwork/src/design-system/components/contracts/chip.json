{
  "schemaVersion": 1,
  "id": "chip",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "chip"
  },
  "summary": "紧凑标签或轻量短选项表面；不替代只读严重度 Badge。",
  "behavior": [
    "tone 与 elevated 只改变受控外观，不隐式增加业务状态",
    "需要选择交互时由调用方显式提供可观察状态和操作语义"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "tone": {
        "type": "string",
        "enum": [
          "primary",
          "secondary",
          "success",
          "warning",
          "error"
        ]
      },
      "elevated": {
        "type": "boolean"
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "进行中",
    "tone": "primary",
    "elevated": false
  },
  "states": [],
  "slots": [
    "default"
  ],
  "events": [],
  "tokenBindings": {
    "background": "color.primary-soft",
    "color": "color.primary",
    "radius": "radius.sm",
    "elevation": "elevation.card",
    "typography": "typography.caption"
  },
  "playground": {
    "presentation": "interactive"
  }
}
