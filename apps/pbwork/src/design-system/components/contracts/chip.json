{
  "schemaVersion": 1,
  "id": "chip",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "chip"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "tone": {
        "type": "string",
        "enum": [
          "primary",
          "secondary",
          "success",
          "warning",
          "error"
        ]
      },
      "elevated": {
        "type": "boolean"
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "进行中",
    "tone": "primary",
    "elevated": false
  },
  "states": [],
  "slots": [
    "default"
  ],
  "events": [],
  "tokenBindings": {
    "background": "color.primary-soft",
    "color": "color.primary",
    "radius": "radius.sm",
    "elevation": "elevation.card",
    "typography": "typography.caption"
  },
  "playground": {
    "presentation": "interactive"
  }
}
