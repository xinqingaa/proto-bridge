{
  "schemaVersion": 1,
  "id": "search-bar",
  "category": "complex",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "search"
  },
  "summary": "上下文内搜索；disabled 阻止输入并使用 opacity.disabled。",
  "behavior": ["disabled 时不可输入、清除或提交，整体使用 opacity.disabled"],
  "propsSchema": {
    "type": "object",
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "placeholder": {
        "type": "string"
      },
      "disabled": {
        "type": "boolean"
      }
    }
  },
  "defaultProps": {
    "modelValue": "空调检修",
    "placeholder": "搜索工单、客户或设备",
    "disabled": false
  },
  "states": [
    {
      "id": "empty",
      "label": "空输入",
      "kind": "content",
      "props": {
        "modelValue": ""
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": ["update:modelValue", "submit"],
  "tokenBindings": {
    "surface": "color.surface-variant",
    "text": "color.on-surface",
    "placeholder": "color.on-surface-muted",
    "radius": "radius.md",
    "height": "sizing.control-lg",
    "typography": "typography.content",
    "disabledOpacity": "opacity.disabled",
    "fill": "layout.fill",
    "icon": "sizing.icon-compact"
  },
  "playground": {
    "presentation": "interactive"
  }
}
