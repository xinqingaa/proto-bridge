{
  "schemaVersion": 1,
  "id": "search-bar",
  "category": "complex",
  "semantic": { "policy": "fixed", "defaultRole": "search" },
  "propsSchema": {
    "type": "object",
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "placeholder": {
        "type": "string"
      },
      "disabled": {
        "type": "boolean"
      }
    }
  },
  "defaultProps": {
    "modelValue": "空调检修",
    "placeholder": "搜索工单、客户或设备",
    "disabled": false
  },
  "states": [
    {
      "id": "empty",
      "label": "空输入",
      "props": {
        "modelValue": ""
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue",
    "submit"
  ],
  "tokenBindings": {
    "surface": "color.surface-variant",
    "text": "color.on-surface",
    "radius": "radius.md",
    "height": "sizing.control-lg",
    "typography": "typography.content"
  }
}
