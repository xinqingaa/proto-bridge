{
  "schemaVersion": 1,
  "id": "toast",
  "category": "feedback",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "toast"
  },
  "summary": "轻量短提示。可只显示文本，也可带一个可选动作（如撤销）。到时自动关闭，不阻断页面。",
  "behavior": [
    "打开后按 toast.duration 自动关闭",
    "无动作时只展示 message",
    "有 actionLabel 时每次打开最多触发一次 undo，撤销事件先于关闭；数据恢复由业务处理"
  ],
  "layout": {
    "summary": "短提示悬浮于内容上方并保持内容宽度；不占据页面流，不阻断下层布局与交互。"
  },
  "visualAnatomy": {
    "summary": "反色表面包含文本；有动作时在同一行末尾放一个文本按钮。无 tone 色条、图标或标题。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "boolean"
      },
      "message": {
        "type": "string"
      },
      "actionLabel": {
        "type": "string"
      }
    },
    "required": ["message"]
  },
  "defaultProps": {
    "modelValue": false,
    "message": "工单已创建",
    "actionLabel": ""
  },
  "states": [
    {
      "id": "visible",
      "label": "显示",
      "kind": "content",
      "props": {
        "modelValue": true,
        "message": "工单已保存"
      }
    },
    {
      "id": "hidden",
      "label": "隐藏",
      "kind": "content",
      "props": {
        "modelValue": false
      }
    }
  ],
  "slots": [],
  "events": ["update:modelValue", "undo"],
  "tokenBindings": {
    "surface": "color.inverse-surface",
    "text": "color.on-inverse-surface",
    "radius": "radius.surface",
    "paddingX": "spacing.sm",
    "paddingY": "toast.gap",
    "message": "typography.content",
    "duration": "toast.duration",
    "gap": "spacing.sm",
    "target": "size.touch",
    "focus": "border.focus",
    "actionPadding": "spacing.xs"
  },
  "playground": {
    "presentation": "trigger"
  },
  "componentTokens": {
    "gap": {
      "valueType": "length",
      "default": "{space.6}",
      "modeVariant": false,
      "bindable": true
    },
    "duration": {
      "valueType": "duration",
      "default": 4000,
      "modeVariant": false,
      "bindable": true
    }
  }
}
