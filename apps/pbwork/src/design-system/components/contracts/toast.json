{
  "schemaVersion": 1,
  "id": "toast",
  "category": "feedback",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "toast"
  },
  "summary": "轻量短提示；半透明黑底纯文本，timeout 后自动关闭，不阻断页面操作。",
  "behavior": [
    "打开后按 motion.duration-toast 自动关闭",
    "仅展示 message 文本，无 tone 色条、图标或关闭按钮"
  ],
  "layout": {
    "summary": "短提示悬浮于内容上方并保持内容宽度；不占据页面流，不阻断下层布局与交互。"
  },
  "visualAnatomy": {
    "summary": "单层半透明黑色 surface 包含纯文本，无 tone 色条、图标、标题或关闭按钮。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": { "type": "boolean" },
      "message": { "type": "string" }
    },
    "required": ["message"]
  },
  "defaultProps": {
    "modelValue": false,
    "message": "工单已创建"
  },
  "states": [
    {
      "id": "visible",
      "label": "显示",
      "kind": "content",
      "props": { "modelValue": true, "message": "工单已保存" }
    },
    {
      "id": "hidden",
      "label": "隐藏",
      "kind": "content",
      "props": { "modelValue": false }
    }
  ],
  "slots": [],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "surface": "color.toast",
    "text": "color.on-toast",
    "radius": "radius.lg",
    "paddingX": "spacing.sm",
    "paddingY": "spacing.xs-plus",
    "message": "typography.content",
    "duration": "motion.duration-toast"
  },
  "playground": {
    "presentation": "trigger"
  }
}
