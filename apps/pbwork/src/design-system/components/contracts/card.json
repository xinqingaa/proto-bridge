{
  "schemaVersion": 1,
  "id": "card",
  "category": "basic",
  "semantic": {
    "policy": "contextual",
    "defaultRole": "section",
    "allowedRoles": ["section", "card", "summary"]
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string"
      },
      "subtitle": {
        "type": "string"
      },
      "elevated": {
        "type": "boolean"
      },
      "semanticRole": {
        "type": "string",
        "enum": ["section", "card", "summary"]
      }
    },
    "required": ["title"]
  },
  "defaultProps": {
    "title": "任务卡片",
    "subtitle": "描述信息",
    "elevated": true,
    "semanticRole": "section"
  },
  "states": [],
  "slots": ["default"],
  "events": [],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "radius": "radius.lg",
    "elevation": "elevation.card",
    "title": "typography.subtitle",
    "subtitle": "typography.caption",
    "muted": "color.on-surface-muted"
  },
  "playground": {
    "presentation": "interactive"
  }
}
