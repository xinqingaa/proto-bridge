{
  "schemaVersion": 1,
  "id": "card",
  "category": "basic",
  "semantic": {
    "policy": "contextual",
    "defaultRole": "section",
    "allowedRoles": ["section", "card", "summary"]
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "elevated": {
        "type": "boolean"
      },
      "semanticRole": {
        "type": "string",
        "enum": ["section", "card", "summary"]
      }
    }
  },
  "defaultProps": {
    "elevated": false,
    "semanticRole": "section"
  },
  "states": [
    {
      "id": "flat",
      "label": "平面",
      "kind": "variant",
      "props": {
        "elevated": false
      }
    },
    {
      "id": "elevated",
      "label": "抬升",
      "kind": "variant",
      "props": {
        "elevated": true
      }
    }
  ],
  "slots": ["default"],
  "events": [],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "radius": "radius.lg",
    "elevation": "elevation.card"
  },
  "playground": {
    "presentation": "interactive"
  }
}
