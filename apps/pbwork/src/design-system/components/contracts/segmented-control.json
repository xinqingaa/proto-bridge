{
  "schemaVersion": 1,
  "id": "segmented-control",
  "category": "input",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "filter"
  },
  "summary": "互斥的局部模式选择，不创建视图区或导航历史。",
  "behavior": [
    "只有未禁用的选项可以被选中；方向键、Home 与 End 支持跳过禁用项",
    "选中项使用 roving tabindex；不拥有 viewport，data-no-swipe 防止父级横滑误触",
    "material=glass 复用共享玻璃材质与透明度降级，保持原有单选和键盘机制。",
    "density=compact将可见轨道及选中底板压低，按钮点击范围仍至少size.touch；不改变单选、禁用、焦点和键盘机制。"
  ],
  "layout": {
    "summary": "互斥的局部模式选择，不创建视图区或导航历史。"
  },
  "visualAnatomy": {
    "summary": "使用当前主题的语义色、字阶、间距和受控形状，不在实例上换绑。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "modelValue": {
        "type": "string"
      },
      "disabled": {
        "type": "boolean"
      },
      "material": {
        "type": "string",
        "enum": [
          "solid",
          "glass"
        ]
      },
      "density": {
        "type": "string",
        "enum": [
          "regular",
          "compact"
        ]
      }
    }
  },
  "defaultProps": {
    "label": "统计范围",
    "items": [
      {
        "id": "week",
        "label": "周"
      },
      {
        "id": "month",
        "label": "月"
      },
      {
        "id": "year",
        "label": "年"
      }
    ],
    "modelValue": "week",
    "disabled": false,
    "material": "solid",
    "density": "regular"
  },
  "states": [
    {
      "id": "month",
      "label": "按月",
      "kind": "content",
      "props": {
        "modelValue": "month"
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    },
    {
      "id": "glass",
      "label": "玻璃",
      "kind": "content",
      "props": {
        "material": "glass"
      }
    },
    {
      "id": "glass-disabled",
      "label": "玻璃禁用",
      "kind": "interaction",
      "props": {
        "material": "glass",
        "disabled": true
      }
    },
    {
      "id": "compact",
      "label": "紧凑",
      "kind": "variant",
      "props": {
        "density": "compact",
        "material": "glass"
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "color": "color.on-surface",
    "gap": "spacing.sm",
    "typography": "typography.content",
    "selection": "color.surface-selected",
    "track": "color.surface-recessed",
    "radius": "radius.control",
    "padding": "spacing.xs",
    "target": "size.touch",
    "focus": "border.focus",
    "disabledOpacity": "opacity.disabled",
    "focusOffset": "spacing.xxs",
    "compactRadius": "radius.control-compact",
    "selectedText": "color.on-surface",
    "inactiveText": "color.on-surface-muted",
    "labelFont": "typography.label",
    "selectedElevation": "elevation.surface",
    "selectedSurface": "color.surface",
    "glassTint": "color.glass-tint",
    "glassEdge": "border.glass",
    "glassLight": "elevation.glass",
    "glassBackdrop": "surface.glass-backdrop",
    "glassFallback": "color.surface",
    "glassFallbackBorder": "border.default",
    "compactHeight": "segmented-control.compact-height",
    "compactSelectionHeight": "segmented-control.compact-selection-height",
    "compactFont": "typography.body-sm",
    "duration": "motion.duration-short",
    "easing": "motion.easing-standard"
  },
  "playground": {
    "presentation": "interactive"
  },
  "componentTokens": {
    "compact-height": {
      "valueType": "length",
      "default": 36,
      "modeVariant": false,
      "bindable": true
    },
    "compact-selection-height": {
      "valueType": "length",
      "default": 30,
      "modeVariant": false,
      "bindable": true
    }
  }
}
