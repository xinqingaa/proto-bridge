{
  "schemaVersion": 1,
  "id": "list-cell",
  "category": "data",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "list-item"
  },
  "summary": "列表单元：前置图标、主副标题、尾部值与导航或开关。",
  "behavior": [
    "导航按钮与 Switch 是独立原生交互区域，不嵌套按钮；开关出现时不再显示导航按钮",
    "整行保持 list-item 身份；主副文案和尾部值各有证据节点，禁用状态阻止操作"
  ],
  "layout": {
    "summary": "列表单元：前置图标、主副标题、尾部值与导航或开关。"
  },
  "visualAnatomy": {
    "summary": "使用当前主题的语义色、字阶、间距和受控形状，不在实例上换绑。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "value": {
        "type": "string"
      },
      "icon": {
        "type": "string"
      },
      "navigation": {
        "type": "boolean"
      },
      "modelValue": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "disabled": {
        "type": "boolean"
      },
      "density": {
        "type": "string",
        "enum": [
          "regular",
          "compact"
        ]
      }
    }
  },
  "defaultProps": {
    "title": "提醒通知",
    "description": "在目标时间提醒",
    "value": "每天",
    "icon": "bell",
    "navigation": true,
    "disabled": false,
    "density": "regular"
  },
  "states": [
    {
      "id": "switch",
      "label": "开关单元",
      "kind": "variant",
      "props": {
        "navigation": false,
        "modelValue": true,
        "value": ""
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    },
    {
      "id": "compact",
      "label": "紧凑行距",
      "kind": "variant",
      "props": {
        "density": "compact"
      }
    }
  ],
  "slots": [
    "leading"
  ],
  "events": [
    "select",
    "update:modelValue"
  ],
  "tokenBindings": {
    "surface": "color.surface",
    "color": "color.on-surface",
    "muted": "color.on-surface-muted",
    "gap": "spacing.sm",
    "typography": "typography.content",
    "border": "border.hairline",
    "target": "size.touch",
    "title": "typography.content",
    "detail": "typography.caption",
    "focus": "border.focus",
    "disabledOpacity": "opacity.disabled",
    "focusOffset": "spacing.xxs",
    "paddingTop": "spacing.md",
    "paddingBottom": "spacing.md",
    "paddingLeft": "spacing.md",
    "paddingRight": "spacing.md"
  },
  "playground": {
    "presentation": "interactive"
  }
}
