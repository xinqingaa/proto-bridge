{
  "schemaVersion": 1,
  "id": "radio-group",
  "category": "basic",
  "semantic": { "policy": "fixed", "defaultRole": "field" },
  "propsSchema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string"
      },
      "modelValue": {
        "type": "string"
      },
      "options": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "优先级",
    "modelValue": "普通",
    "options": [
      "低",
      "普通",
      "紧急"
    ],
    "disabled": false
  },
  "states": [
    {
      "id": "disabled",
      "label": "禁用",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "selected": "color.primary",
    "text": "color.on-surface",
    "label": "typography.caption",
    "option": "typography.content"
  }
}
