{
  "schemaVersion": 1,
  "id": "radio-group",
  "category": "basic",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "field"
  },
  "summary": "互斥单选；选中色为 Token-ref，禁用走 opacity.disabled。",
  "behavior": [
    "color 只接受 Bind 池 Token ID，禁止硬编码色值",
    "disabled 使用 opacity.disabled"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "modelValue": {
        "type": "string"
      },
      "options": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "color": {
        "type": "string",
        "description": "Selected control Token-ref."
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "优先级",
    "modelValue": "普通",
    "options": [
      "低",
      "普通",
      "紧急"
    ],
    "color": "color.primary",
    "disabled": false
  },
  "states": [
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "selected": "color.primary",
    "text": "color.on-surface",
    "label": "typography.caption",
    "option": "typography.content",
    "disabledOpacity": "opacity.disabled"
  },
  "playground": {
    "presentation": "single"
  }
}
