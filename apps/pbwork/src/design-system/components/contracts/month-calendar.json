{
  "schemaVersion": 1,
  "id": "month-calendar",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "section"
  },
  "summary": "按月选择日期，使用固定星期顺序与受控月份。",
  "behavior": [
    "月份和日期来自 props，不使用系统当前时间；非法月份不渲染错误日历",
    "一周从周一开始，前后月切换正确跨年；禁用日期不可选",
    "方向键和 Home/End 在当前月可用日期间移动焦点，Enter/Space 选择",
    "day 插槽只替换日期单元内容，暴露 date/selected/today/disabled；日期计算、焦点、禁用与键盘由组件管理。dayLabels提供每日期的可访问说明。"
  ],
  "layout": {
    "summary": "Header with previous/month/next; weekday row then seven equal cells per row using normal flow; no internal scroll owner."
  },
  "visualAnatomy": {
    "summary": "可读年月、SVG 翻月入口、等分七列以及普通/今日/选中/禁用日期层次。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "month": {
        "type": "string"
      },
      "modelValue": {
        "type": "string"
      },
      "disabledDates": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "today": {
        "type": "string"
      },
      "dayLabels": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "defaultProps": {
    "label": "选择日期",
    "month": "2026-07",
    "modelValue": "2026-07-28",
    "disabledDates": ["2026-07-15"],
    "today": "2026-07-16"
  },
  "states": [
    {
      "id": "next-month",
      "label": "八月",
      "kind": "content",
      "props": {
        "month": "2026-08",
        "modelValue": "2026-08-01"
      }
    },
    {
      "id": "empty-selection",
      "label": "未选择",
      "kind": "content",
      "props": {
        "modelValue": ""
      }
    }
  ],
  "slots": ["day"],
  "events": ["update:modelValue", "update:month"],
  "tokenBindings": {
    "color": "color.on-surface",
    "muted": "color.on-surface-muted",
    "gap": "spacing.sm",
    "typography": "typography.content",
    "radius": "radius.control",
    "padding": "spacing.xs",
    "target": "size.touch",
    "focus": "border.focus",
    "disabledOpacity": "opacity.disabled",
    "caption": "typography.caption",
    "selectedColor": "color.on-primary",
    "selectedSurface": "color.primary",
    "cellGap": "spacing.xs",
    "focusOffset": "spacing.xxs",
    "weekdayHeight": "size.control-compact",
    "rowGap": "spacing.sm-plus",
    "headerGap": "spacing.sm",
    "headerBorder": "border.hairline",
    "heading": "typography.subtitle",
    "number": "typography.numeric-content",
    "todayWidth": "border.width",
    "todayColor": "color.primary",
    "dayRadius": "radius.pill"
  },
  "playground": {
    "presentation": "interactive"
  }
}
