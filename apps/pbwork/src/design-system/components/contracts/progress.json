{
  "schemaVersion": 1,
  "id": "progress",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "loading-state"
  },
  "summary": "展示确定或不确定进度；只提供状态反馈，不阻断页面操作。",
  "behavior": [
    "indeterminate 表示未知完成比例，不能同时宣称精确 value",
    "确定进度保持在有效范围内，并以 label 提供可访问说明"
  ],
  "propsSchema": {
    "type": "object",
    "properties": {
      "value": {
        "type": "number"
      },
      "indeterminate": {
        "type": "boolean"
      },
      "label": {
        "type": "string"
      }
    }
  },
  "defaultProps": {
    "value": 68,
    "indeterminate": false,
    "label": "工单完成度"
  },
  "states": [
    {
      "id": "indeterminate",
      "label": "加载中",
      "kind": "interaction",
      "props": {
        "indeterminate": true
      }
    },
    {
      "id": "complete",
      "label": "已完成",
      "kind": "content",
      "props": {
        "value": 100
      }
    }
  ],
  "slots": [],
  "events": [],
  "tokenBindings": {
    "fill": "color.primary",
    "track": "color.primary-soft",
    "radius": "radius.full",
    "motion": "motion.duration-normal",
    "gap": "spacing.xs-plus",
    "text": "color.on-surface",
    "label": "typography.caption",
    "trackHeight": "sizing.progress-track",
    "trackOpacity": "opacity.visible"
  },
  "playground": {
    "presentation": "interactive"
  }
}
