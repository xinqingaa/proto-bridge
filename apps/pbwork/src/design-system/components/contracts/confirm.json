{
  "schemaVersion": 1,
  "id": "confirm",
  "category": "feedback",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "dialog"
  },
  "summary": "确认类模态对话框；需用户显式确认或关闭，不承担底栏流程。",
  "behavior": [
    "默认关闭；Playground 与产品页通过触发打开",
    "确认会先发出 confirm，再关闭自身；调用方决定后续业务动作与导航",
    "决策区走 Button 类型：一颗时主要类型占满；两颗时左侧次要类型、右侧主要类型，等分撑满容器且文案尽量等长",
    "不替代 BottomSheet / FlowSheet 的流程承载",
    "material=solid保留实色表面，glass复用共享玻璃材质及实色降级；材质不改变关闭、焦点、滚动或步骤机制。"
  ],
  "layout": {
    "summary": "对话框在视口内居中并受 dialog-max-width 约束；正文与操作区保持稳定纵向次序。"
  },
  "visualAnatomy": {
    "summary": "scrim、raised dialog surface、标题/正文和决策区构成四层固定结构；决策区一颗主要类型占满，两颗时等分撑满。"
  },
  "propsSchema": {
    "type": "object",
    "properties": {
      "modelValue": {
        "type": "boolean"
      },
      "title": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "confirmLabel": {
        "type": "string"
      },
      "cancelLabel": {
        "type": "string"
      },
      "showCancel": {
        "type": "boolean"
      },
      "contained": {
        "type": "boolean"
      },
      "material": {
        "type": "string",
        "enum": [
          "solid",
          "glass"
        ]
      }
    },
    "required": [
      "title"
    ]
  },
  "defaultProps": {
    "modelValue": false,
    "title": "确认完成工单？",
    "message": "完成后将通知客户，并记录处理结果。",
    "confirmLabel": "确认",
    "cancelLabel": "取消",
    "showCancel": true,
    "contained": true,
    "material": "solid"
  },
  "states": [
    {
      "id": "open",
      "label": "打开",
      "kind": "content",
      "props": {
        "modelValue": true
      }
    },
    {
      "id": "glass",
      "label": "玻璃面板",
      "kind": "variant",
      "props": {
        "modelValue": true,
        "material": "glass"
      }
    }
  ],
  "slots": [
    "default"
  ],
  "events": [
    "update:modelValue",
    "confirm"
  ],
  "tokenBindings": {
    "scrim": "color.scrim",
    "surface": "color.surface-raised",
    "border": "color.border",
    "text": "color.on-surface",
    "radius": "radius.overlay",
    "elevation": "elevation.overlay",
    "title": "typography.title",
    "body": "typography.content",
    "glassTint": "color.glass-tint",
    "glassEdge": "border.glass",
    "glassLight": "elevation.glass",
    "glassBackdrop": "surface.glass-backdrop",
    "glassFallback": "color.surface",
    "glassFallbackBorder": "border.default"
  },
  "playground": {
    "presentation": "trigger"
  }
}
