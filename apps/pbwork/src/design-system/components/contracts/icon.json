{
  "schemaVersion": 1,
  "id": "icon",
  "category": "basic",
  "semantic": {
    "policy": "decorative"
  },
  "summary": "Lucide 常用图标；按稳定 name 渲染，尺寸与颜色走 Token。",
  "behavior": [
    "不是按钮；可点操作使用 icon-button",
    "name 仅允许 DS 策展清单内的 Lucide 稳定 id",
    "无 label 时按装饰图标处理（aria-hidden）"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "enum": [
          "more",
          "plus",
          "search",
          "settings",
          "home",
          "list",
          "user",
          "inbox",
          "check",
          "chevron-down",
          "chevron-right",
          "alert-triangle",
          "alert-circle",
          "clock",
          "refresh-cw",
          "clipboard-check",
          "shield-check",
          "folder-open",
          "thermometer",
          "snowflake",
          "copy",
          "file-text",
          "sliders-horizontal"
        ]
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "tone": {
        "type": "string",
        "enum": [
          "inherit",
          "on-surface",
          "muted",
          "primary",
          "action",
          "error",
          "success",
          "warning"
        ]
      },
      "label": {
        "type": "string"
      }
    },
    "required": [
      "name"
    ]
  },
  "defaultProps": {
    "name": "more",
    "size": "md",
    "tone": "inherit",
    "label": ""
  },
