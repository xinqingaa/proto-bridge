{
  "schemaVersion": 1,
  "id": "tabs",
  "category": "complex",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": { "type": "string" },
      "background": {
        "type": "string",
        "enum": ["transparent", "surface", "surface-variant"]
      },
      "activeStyle": { "type": "string", "enum": ["text", "tonal"] },
      "tone": { "type": "string", "enum": ["primary", "secondary"] },
      "showIndicator": { "type": "boolean" },
      "showDivider": { "type": "boolean" },
      "grow": { "type": "boolean" },
      "align": { "type": "string", "enum": ["start", "center"] },
      "radius": {
        "type": "string",
        "enum": ["none", "sm", "md", "lg", "full"]
      },
      "size": { "type": "string", "enum": ["sm", "md", "lg"] },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "label"],
          "properties": {
            "value": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "required": ["items"]
  },
  "defaultProps": {
    "modelValue": "overview",
    "background": "transparent",
    "activeStyle": "text",
    "tone": "primary",
    "showIndicator": true,
    "showDivider": false,
    "grow": false,
    "align": "start",
    "radius": "md",
    "size": "md",
    "items": [
      { "value": "overview", "label": "概览" },
      { "value": "activity", "label": "活动" }
    ]
  },
  "states": [
    {
      "id": "tonal",
      "label": "柔和选中",
      "props": { "activeStyle": "tonal", "showIndicator": false }
    },
    { "id": "equal", "label": "等宽", "props": { "grow": true } },
    {
      "id": "minimal",
      "label": "极简",
      "props": { "showIndicator": false, "showDivider": false }
    }
  ],
  "slots": ["overview", "activity"],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "indicator": "color.primary",
    "activeBackground": "color.primary-soft",
    "inactiveColor": "color.on-surface-muted",
    "surface": "color.surface",
    "border": "color.border",
    "radius": "radius.md",
    "typography": "typography.content",
    "duration": "motion.duration-slow",
    "easing": "motion.easing-standard"
  }
}
