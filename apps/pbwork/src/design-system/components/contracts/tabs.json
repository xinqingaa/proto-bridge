    "modelValue": "overview",
    "items": [
      { "value": "overview", "label": "概览" },
      { "value": "activity", "label": "活动" }
    ]
  },
  "states": [],
  "slots": [],
  "events": ["update:modelValue"],
  "tokenBindings": { "indicator": "color.primary" }
}
