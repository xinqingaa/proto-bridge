{
  "schemaVersion": 1,
  "id": "tabs",
  "category": "complex",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "tab-bar"
  },
  "summary": "页内 pill 分段：轨道容器带圆角背景，选中胶囊左右滑动过渡。",
  "behavior": [
    "最外层 tab 轨道有表面背景与圆角；选中态为滑动胶囊（非瞬时换底）",
    "切换时胶囊沿水平方向过渡（左→右或右→左）",
    "内容必须进具名 slot；短内容可滑用 fill",
    "swipe / mouseSwipe 分离，不可互兜底",
    "一级 BottomNavigation 面板内禁止再嵌套带 window 的 Tabs",
    "prefers-reduced-motion: reduce 时关闭胶囊位移过渡"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "showIndicator": {
        "type": "boolean"
      },
      "showDivider": {
        "type": "boolean"
      },
      "grow": {
        "type": "boolean"
      },
      "align": {
        "type": "string",
        "enum": [
          "start",
          "center"
        ]
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "swipe": {
        "type": "boolean"
      },
      "mouseSwipe": {
        "type": "boolean"
      },
      "fill": {
        "type": "boolean"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "required": [
      "items"
    ]
  },
  "defaultProps": {
    "modelValue": "overview",
    "showIndicator": false,
    "showDivider": false,
    "grow": false,
    "align": "start",
    "size": "md",
    "swipe": true,
    "mouseSwipe": true,
    "fill": false,
    "items": [
      {
        "value": "overview",
        "label": "概览"
      },
      {
        "value": "activity",
        "label": "活动"
      }
    ]
  },
  "states": [
    {
      "id": "equal",
      "label": "等宽",
      "kind": "variant",
      "props": {
        "grow": true
      }
    }
  ],
  "slots": [
    "overview",
    "activity"
  ],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "trackBackground": "color.surface-variant",
    "indicator": "color.primary",
    "activeBackground": "color.surface",
    "activeColor": "color.primary",
    "inactiveColor": "color.on-surface-muted",
    "border": "border.hairline",
    "trackRadius": "radius.lg",
    "radius": "radius.full",
    "height": "sizing.control-md",
    "target": "sizing.touch",
    "typography": "typography.label",
    "panel": "typography.caption",
    "duration": "motion.duration-slow",
    "easing": "motion.easing-standard"
  },
  "playground": {
    "presentation": "single"
  }
}
