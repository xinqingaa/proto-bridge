{
  "schemaVersion": 1,
  "id": "tabs",
  "category": "complex",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": { "type": "string" },
      "selectionStyle": {
        "type": "string",
        "enum": ["pill", "underline", "text"]
      },
      "showIndicator": { "type": "boolean" },
      "showDivider": { "type": "boolean" },
      "grow": { "type": "boolean" },
      "align": { "type": "string", "enum": ["start", "center"] },
      "size": { "type": "string", "enum": ["sm", "md", "lg"] },
      "swipe": { "type": "boolean" },
      "mouseSwipe": { "type": "boolean" },
      "fill": { "type": "boolean" },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "label"],
          "properties": {
            "value": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "required": ["items"]
  },
  "defaultProps": {
    "modelValue": "overview",
    "selectionStyle": "pill",
    "showIndicator": false,
    "showDivider": false,
    "grow": false,
    "align": "start",
    "size": "md",
    "swipe": true,
    "mouseSwipe": true,
    "fill": false,
    "items": [
      { "value": "overview", "label": "概览" },
      { "value": "activity", "label": "活动" }
    ]
  },
  "states": [
    {
      "id": "underline",
      "label": "滑线",
      "props": { "selectionStyle": "underline", "showIndicator": true }
    },
    { "id": "equal", "label": "等宽", "props": { "grow": true } },
    {
      "id": "minimal",
      "label": "极简",
      "props": {
        "selectionStyle": "text",
        "showIndicator": false,
        "showDivider": false
      }
    }
  ],
  "slots": ["overview", "activity"],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "indicator": "color.primary",
    "activeBackground": "color.primary-soft",
    "activeColor": "color.primary",
    "inactiveColor": "color.on-surface-muted",
    "border": "border.hairline",
    "radius": "radius.full",
    "height": "sizing.control-md",
    "target": "sizing.touch",
    "typography": "typography.label",
    "panel": "typography.caption",
    "duration": "motion.duration-slow",
    "easing": "motion.easing-standard"
  }
}
