{
  "schemaVersion": 1,
  "id": "tag",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "badge"
  },
  "summary": "紧凑只读分类或状态标签，不承担选择交互。",
  "behavior": [
    "tone 是有限语义，不能传颜色或 Token 重绑",
    "只读标签没有按钮角色或可点击样式；筛选使用 SegmentedControl 或 FilterBar"
  ],
  "layout": {
    "summary": "紧凑只读分类或状态标签，不承担选择交互。"
  },
  "visualAnatomy": {
    "summary": "使用当前主题的语义色、字阶、间距和受控形状，不在实例上换绑。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "tone": {
        "type": "string",
        "enum": ["neutral", "primary", "success", "warning", "error"]
      }
    }
  },
  "defaultProps": {
    "label": "进行中",
    "tone": "neutral"
  },
  "states": [
    {
      "id": "success",
      "label": "完成",
      "kind": "variant",
      "props": {
        "tone": "success",
        "label": "已完成"
      }
    },
    {
      "id": "warning",
      "label": "提醒",
      "kind": "variant",
      "props": {
        "tone": "warning",
        "label": "待处理"
      }
    }
  ],
  "slots": [],
  "events": [],
  "tokenBindings": {
    "background": "color.surface-variant",
    "color": "color.on-surface",
    "radius": "radius.mark",
    "typography": "typography.caption-strong",
    "paddingX": "spacing.xs",
    "paddingY": "spacing.xxs"
  },
  "playground": {
    "presentation": "interactive"
  }
}
