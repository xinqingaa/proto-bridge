{
  "schemaVersion": 1,
  "id": "primary-tabs",
  "category": "navigation",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "tab-bar"
  },
  "summary": "当前页面的主要内容分区：每项对应具名内容面板，轨道和选中胶囊均由主题语义表面令牌决定。可关闭视口以承接局部受控选择。",
  "behavior": [
    "轨道填满组件容器而非视口；默认项按内容宽排列，equal 状态才平分轨道，项过多时横向滚动",
    "轨道使用共享玻璃材质；选中底使用中性透明填色和高光，不叠加背景滤镜，保持比主 Tabbar 更轻的层级。",
    "首次进入时先完成胶囊定位再开启后续切换动效，避免出现无选中态的首帧",
    "内容进入对应具名视图；可按场景启用触摸或鼠标横滑",
    "同一物理区域只有一个横滑 owner；嵌套时由页面关闭外层横滑",
    "viewport=false 时只呈现受控选择条，不挂载面板或接管视口滑动；disabled 阻止点击、键盘与拖动选择。"
  ],
  "layout": {
    "summary": "小圆角玻璃轨道填满容器，选项默认按内容宽排列，equal 状态等分；选中底连续滑动，内容视口由组件所有。",
    "containerWidth": "fill-parent",
    "track": {
      "width": "fill-container",
      "itemSizing": "content",
      "equalState": "equal",
      "overflow": "horizontal-scroll"
    },
    "viewport": {
      "ownership": "component",
      "transition": "horizontal"
    }
  },
  "visualAnatomy": {
    "summary": "保留原有小圆角玻璃轨道、高光边缘和内外光影；浅色选中底使用半透明白色，避免灰蓝叠色。",
    "selection": {
      "material": "theme-controlled",
      "border": "semantic-glass-edge",
      "layering": "floating",
      "contour": "host-radius"
    }
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "showIndicator": {
        "type": "boolean"
      },
      "showDivider": {
        "type": "boolean"
      },
      "grow": {
        "type": "boolean"
      },
      "align": {
        "type": "string",
        "enum": ["start", "center"]
      },
      "size": {
        "type": "string",
        "enum": ["sm", "md", "lg"]
      },
      "swipe": {
        "type": "boolean"
      },
      "mouseSwipe": {
        "type": "boolean"
      },
      "fill": {
        "type": "boolean"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "label"],
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      },
      "viewport": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      },
      "label": {
        "type": "string"
      }
    },
    "required": ["items"]
  },
  "defaultProps": {
    "modelValue": "overview",
    "showIndicator": false,
    "showDivider": false,
    "grow": false,
    "align": "start",
    "size": "md",
    "swipe": true,
    "mouseSwipe": true,
    "fill": false,
    "items": [
      {
        "value": "overview",
        "label": "概览"
      },
      {
        "value": "activity",
        "label": "活动"
      },
      {
        "value": "data",
        "label": "数据"
      },
      {
        "value": "settings",
        "label": "设置"
      }
    ],
    "viewport": true,
    "disabled": false
  },
  "states": [
    {
      "id": "equal",
      "label": "等宽",
      "kind": "variant",
      "props": {
        "grow": true
      }
    },
    {
      "id": "selection-only",
      "label": "仅选择条",
      "kind": "variant",
      "props": {
        "viewport": false,
        "swipe": false
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": ["overview", "activity", "data", "settings"],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "selectionSurface": "color.surface-selected",
    "selectionOpacity": "opacity.translucent",
    "selectionElevation": "elevation.floating",
    "activeColor": "primary-tabs.active-color",
    "inactiveColor": "color.on-surface-muted",
    "border": "border.hairline",
    "trackRadius": "radius.control",
    "radius": "radius.control-compact",
    "height": "size.control",
    "target": "size.touch",
    "typography": "typography.label",
    "panel": "typography.caption",
    "trackInset": "spacing.xs",
    "panelGap": "spacing.sm-plus",
    "indicatorInset": "spacing.sm-plus",
    "indicatorOffset": "spacing.xxs",
    "indicatorThickness": "size.indicator",
    "glassBackdrop": "surface.glass-backdrop",
    "duration": "motion.duration-long",
    "easing": "motion.easing-standard",
    "materialOpacity": "opacity.translucent",
    "materialBackdrop": "surface.glass-backdrop",
    "materialBorder": "border.default",
    "glassTint": "color.glass-tint",
    "glassClear": "color.glass-clear",
    "glassEdge": "border.glass",
    "glassFallback": "color.surface",
    "glassFallbackBorder": "border.default",
    "selectionTint": "primary-tabs.selection-tint",
    "glassLight": "elevation.glass",
    "disabledOpacity": "opacity.disabled"
  },
  "playground": {
    "presentation": "interactive"
  },
  "componentTokens": {
    "active-color": {
      "valueType": "color",
      "default": "{color.on-surface}",
      "modeVariant": true,
      "bindable": true,
      "label": "一级标签选中文字"
    },
    "selection-treatment": {
      "valueType": "enum",
      "default": "{surface.treatment}",
      "modeVariant": false,
      "enumValues": ["solid", "outlined", "glass"],
      "bindable": false
    },
    "selection-tint": {
      "valueType": "color",
      "default": "{color.glass-clear}",
      "modeVariant": true,
      "bindable": true,
      "label": "页内导航选中玻璃底色"
    }
  }
}
