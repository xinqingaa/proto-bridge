{
  "schemaVersion": 1,
  "id": "primary-tabs",
  "category": "navigation",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "tab-bar"
  },
  "summary": "一级页内分区：轨道和选中胶囊均由主题语义表面令牌决定。",
  "behavior": [
    "轨道填满组件容器而非视口；默认项按内容宽排列，equal 状态才平分轨道，项过多时横向滚动",
    "轨道使用 color.surface-recessed，当前项使用 color.surface-selected；当前项为无描边、悬浮的半透明玻璃选中面，顶部仅以低对比阴影形成承托过渡，不形成第二道表面、边框或渐变",
    "首次进入时先完成胶囊定位再开启后续切换动效，避免出现无选中态的首帧",
    "内容进入对应具名视图；可按场景启用触摸或鼠标横滑",
    "同一物理区域只有一个横滑 owner；嵌套时由页面关闭外层横滑"
  ],
  "layout": {
    "containerWidth": "fill-parent",
    "track": {
      "width": "fill-container",
      "itemSizing": "content",
      "equalState": "equal",
      "overflow": "horizontal-scroll"
    },
    "viewport": {
      "ownership": "component",
      "transition": "horizontal"
    }
  },
  "visualAnatomy": {
    "selection": {
      "material": "translucent-glass",
      "border": "none",
      "layering": "floating",
      "contour": "top-transition-arc"
    }
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "showIndicator": {
        "type": "boolean"
      },
      "showDivider": {
        "type": "boolean"
      },
      "grow": {
        "type": "boolean"
      },
      "align": {
        "type": "string",
        "enum": [
          "start",
          "center"
        ]
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "swipe": {
        "type": "boolean"
      },
      "mouseSwipe": {
        "type": "boolean"
      },
      "fill": {
        "type": "boolean"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "required": [
      "items"
    ]
  },
  "defaultProps": {
    "modelValue": "overview",
    "showIndicator": false,
    "showDivider": false,
    "grow": false,
    "align": "start",
    "size": "md",
    "swipe": true,
    "mouseSwipe": true,
    "fill": false,
    "items": [
      {
        "value": "overview",
        "label": "概览"
      },
      {
        "value": "activity",
        "label": "活动"
      },
      {
        "value": "data",
        "label": "数据"
      },
      {
        "value": "settings",
        "label": "设置"
      }
    ]
  },
  "states": [
    {
      "id": "equal",
      "label": "等宽",
      "kind": "variant",
      "props": {
        "grow": true
      }
    }
  ],
  "slots": [
    "overview",
    "activity",
    "data",
    "settings"
  ],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "trackSurface": "color.surface-recessed",
    "selectionSurface": "color.surface-selected",
    "selectionOpacity": "opacity.glass",
    "selectionElevation": "elevation.glass",
    "activeColor": "color.section-tab-active",
    "inactiveColor": "color.on-surface-muted",
    "border": "border.hairline",
    "trackRadius": "radius.lg",
    "radius": "radius.full",
    "height": "sizing.control-md",
    "target": "sizing.touch",
    "typography": "typography.label",
    "panel": "typography.caption",
    "trackInset": "spacing.xs",
    "panelGap": "spacing.sm-plus",
    "indicatorInset": "spacing.sm-plus",
    "indicatorOffset": "spacing.xxs",
    "indicatorThickness": "sizing.indicator-thickness",
    "fill": "layout.fill",
    "selectionLayer": "layer.content",
    "glassBackdrop": "effect.glass-backdrop",
    "reducedDuration": "motion.duration-instant",
    "duration": "motion.duration-slow",
    "easing": "motion.easing-standard",
    "bridgeOffset": "layout.inset-xs-negative",
    "hiddenOpacity": "opacity.hidden",
    "visibleOpacity": "opacity.visible"
  },
  "playground": {
    "presentation": "interactive"
  }
}
