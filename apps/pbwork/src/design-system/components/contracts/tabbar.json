{
  "schemaVersion": 1,
  "id": "tabbar",
  "category": "navigation",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "bottom-bar"
  },
  "summary": "应用根目的地导航：视图区在上，底部只负责当前位置与目的地切换。",
  "behavior": [
    "固定同时展示图标与文字；适用于 2–5 个应用根目的地",
    "所有目的地始终均分导航轨道，不提供按内容宽度排列的模式。",
    "点击无 ripple 反馈；同一个玻璃选中底随当前位置连续滑动并适配宽度，图标与文字使用强调色。支持方向键及 Home/End，降低动态效果时取消滑动。",
    "不拥有视图区、转场或横滑；页面壳以 TabViewport 承接内容"
  ],
  "layout": {
    "summary": "小圆角浮动玻璃底栏保留安全区留白，所有目的地等宽平分。"
  },
  "visualAnatomy": {
    "summary": "主体使用 radius.surface，选中底使用 radius.control；玻璃材质上以薄选中底、强调色图标与文字指示目的地。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "label"],
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "required": ["items"]
  },
  "defaultProps": {
    "modelValue": "home",
    "items": [
      {
        "value": "home",
        "label": "首页"
      },
      {
        "value": "tasks",
        "label": "任务"
      },
      {
        "value": "profile",
        "label": "我的"
      }
    ]
  },
  "states": [
    {
      "id": "tasks-selected",
      "label": "任务选中",
      "kind": "content",
      "props": {
        "modelValue": "tasks"
      }
    }
  ],
  "slots": [],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "surface": "color.surface-raised",
    "active": "tabbar.active",
    "inactive": "color.on-surface-muted",
    "border": "border.hairline",
    "target": "size.touch",
    "height": "size.navigation-bar",
    "label": "typography.caption",
    "selectedLabel": "typography.caption-strong",
    "focusOutline": "border.focus",
    "iconSize": "size.icon",
    "materialOpacity": "opacity.translucent",
    "materialBackdrop": "surface.glass-backdrop",
    "materialBorder": "border.default",
    "glassTint": "color.glass-tint",
    "glassClear": "color.glass-clear",
    "glassEdge": "border.glass",
    "glassLight": "elevation.glass",
    "glassFallback": "color.surface",
    "glassFallbackBorder": "border.default",
    "selectionTint": "tabbar.selection-tint",
    "radius": "radius.surface",
    "inset": "spacing.xs",
    "outerInset": "spacing.md",
    "duration": "motion.duration-long",
    "easing": "motion.easing-standard",
    "selectionRadius": "radius.control"
  },
  "playground": {
    "presentation": "interactive"
  },
  "icons": {
    "pack": "pbwork",
    "defaults": ["home", "list", "user"],
    "artwork": "_shared/glyph-artwork.json"
  },
  "componentTokens": {
    "active": {
      "valueType": "color",
      "default": "{color.primary}",
      "modeVariant": true,
      "bindable": true,
      "label": "底部导航选中颜色"
    },
    "surface-treatment": {
      "valueType": "enum",
      "default": "glass",
      "modeVariant": false,
      "enumValues": ["solid", "outlined", "glass"],
      "bindable": false
    },
    "selection-tint": {
      "valueType": "color",
      "default": "{color.glass-tint}",
      "modeVariant": true,
      "bindable": true,
      "label": "主导航选中玻璃底色"
    }
  }
}
