{
  "schemaVersion": 1,
  "id": "tabbar",
  "category": "navigation",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "bottom-bar"
  },
  "summary": "应用根目的地导航：视图区在上，底部只负责当前位置与目的地切换。",
  "behavior": [
    "固定同时展示图标与文字；适用于 2–5 个应用根目的地",
    "默认等宽平分导航轨道；grow=false 时按内容自适应宽度排列",
    "点击无 ripple 反馈，立即切换；选中仅以 color.navigation-active 与 600 字重表达，不显示顶部指示器",
    "不拥有视图区、转场或横滑；页面壳以 TabViewport 或路由承接内容"
  ],
  "layout": {
    "summary": "底部导航轨道填满应用壳宽度；默认 2–5 个目的地等分，grow=false 时按内容排列。"
  },
  "visualAnatomy": {
    "summary": "单一底栏 surface 上固定展示图标与文字；选中态不增加顶部指示器或独立胶囊。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "grow": {
        "type": "boolean"
      },
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "required": [
      "items"
    ]
  },
  "defaultProps": {
    "modelValue": "home",
    "grow": true,
    "items": [
      {
        "value": "home",
        "label": "首页"
      },
      {
        "value": "tasks",
        "label": "任务"
      },
      {
        "value": "profile",
        "label": "我的"
      }
    ]
  },
  "states": [
    {
      "id": "tasks-selected",
      "label": "任务选中",
      "kind": "content",
      "props": {
        "modelValue": "tasks"
      }
    },
    {
      "id": "adaptive",
      "label": "自适应",
      "kind": "variant",
      "props": {
        "grow": false
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "surface": "color.surface-raised",
    "active": "color.navigation-active",
    "inactive": "color.on-surface-muted",
    "border": "border.hairline",
    "target": "sizing.touch",
    "height": "sizing.bottom-navigation",
    "label": "typography.caption",
    "selectedLabel": "typography.caption-strong",
    "fill": "layout.fill",
    "focusInset": "layout.focus-inset",
    "contentLayer": "layer.content",
    "safeInsetFallback": "spacing.none",
    "overlayOpacity": "opacity.hidden",
    "focusOutline": "border.focus",
    "iconSize": "sizing.icon-md"
  },
  "playground": {
    "presentation": "interactive"
  },
  "icons": {
    "pack": "lucide",
    "defaults": [
      "home",
      "list",
      "user"
    ]
  }
}
