{
  "schemaVersion": 1,
  "id": "text-field",
  "category": "basic",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": { "type": "string" },
      "modelValue": { "type": "string" },
      "disabled": { "type": "boolean" },
      "radius": { "type": "string", "enum": ["sm", "md", "lg"] },
      "size": { "type": "string", "enum": ["sm", "md", "lg"] }
    },
    "required": ["label"]
  },
  "defaultProps": {
    "label": "标题",
    "modelValue": "",
    "disabled": false,
    "radius": "md",
    "size": "md"
  },
  "states": [],
  "slots": [],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "border": "color.border",
    "surface": "color.surface",
    "radius": "radius.md",
    "height": "sizing.control-md",
    "label": "typography.caption",
    "input": "typography.content"
  }
}
