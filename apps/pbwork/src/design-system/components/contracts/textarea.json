{
  "schemaVersion": 1,
  "id": "textarea",
  "category": "basic",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "field"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "modelValue": {
        "type": "string"
      },
      "rows": {
        "type": "number"
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "问题描述",
    "modelValue": "现场设备出现异常噪声",
    "rows": 3,
    "disabled": false
  },
  "states": [
    {
      "id": "disabled",
      "label": "禁用",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "focus": "color.primary",
    "radius": "radius.md",
    "text": "typography.content"
  },
  "playground": {
    "presentation": "single"
  }
}
