{
  "schemaVersion": 1,
  "id": "textarea",
  "category": "input",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "field"
  },
  "summary": "多行文本输入；默认 plain 无标题无描边；showLabel 时显示标题并启用边框；disabled 使用 opacity.disabled。",
  "behavior": [
    "showLabel 默认 false：不渲染标题、无描边，仅保留可输入区域",
    "showLabel 为 true 时显示 label 并启用边框",
    "disabled 时不可聚焦或编辑，整体使用 opacity.disabled"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": { "type": "string" },
      "showLabel": { "type": "boolean" },
      "modelValue": { "type": "string" },
      "placeholder": { "type": "string" },
      "disabled": { "type": "boolean" }
    }
  },
  "defaultProps": {
    "label": "问题描述",
    "showLabel": false,
    "modelValue": "现场设备出现异常噪声",
    "placeholder": "",
    "disabled": false
  },
  "states": [
    {
      "id": "labeled",
      "label": "显示标题",
      "kind": "variant",
      "props": {
        "showLabel": true,
        "label": "问题描述",
        "modelValue": "设备运行时出现异常噪声。"
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": { "disabled": true }
    }
  ],
  "slots": [],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "focus": "color.primary",
    "radius": "radius.md",
    "text": "typography.content",
    "disabledOpacity": "opacity.disabled",
    "rows": "sizing.textarea-rows"
  },
  "playground": {
    "presentation": "interactive"
  }
}
