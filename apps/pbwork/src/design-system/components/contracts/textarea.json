{
  "schemaVersion": 1,
  "id": "textarea",
  "category": "basic",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "field"
  },
  "summary": "多行文本输入；disabled 阻止编辑并使用 opacity.disabled。",
  "behavior": ["disabled 时不可聚焦或编辑，整体使用 opacity.disabled"],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "modelValue": {
        "type": "string"
      },
      "rows": {
        "type": "number"
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": ["label"]
  },
  "defaultProps": {
    "label": "问题描述",
    "modelValue": "现场设备出现异常噪声",
    "rows": 3,
    "disabled": false
  },
  "states": [
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "focus": "color.primary",
    "radius": "radius.md",
    "text": "typography.content",
    "disabledOpacity": "opacity.disabled"
  },
  "playground": {
    "presentation": "interactive"
  }
}
