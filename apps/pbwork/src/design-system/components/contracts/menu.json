{
  "schemaVersion": 1,
  "id": "menu",
  "category": "input",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "field"
  },
  "summary": "有限选项选择；loading 保持可读忙碌反馈，disabled 使用 opacity.disabled。",
  "behavior": [
    "loading 表示选项正在准备，不得与禁用视觉混同",
    "disabled 阻止打开或选择，整体使用 opacity.disabled"
  ],
  "layout": {
    "summary": "触发字段占用父级可用宽度；选项面板与字段对齐并受 menu-max-height 约束。"
  },
  "visualAnatomy": {
    "summary": "标签、输入表面、状态提示与浮动选项面板分层；loading 与 disabled 共享结构但不共享语义。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "modelValue": {
        "type": "string"
      },
      "options": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "placeholder": {
        "type": "string"
      },
      "clearable": {
        "type": "boolean"
      },
      "loading": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      },
      "open": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "服务类型",
    "modelValue": "维修",
    "options": [
      "维修",
      "巡检",
      "安装"
    ],
    "placeholder": "请选择服务类型",
    "clearable": true,
    "loading": false,
    "error": "",
    "open": false,
    "disabled": false
  },
  "states": [
    {
      "id": "open",
      "label": "展开菜单",
      "kind": "content",
      "description": "直接体验展开后的选项菜单",
      "props": {
        "open": true
      }
    },
    {
      "id": "loading",
      "label": "加载",
      "kind": "interaction",
      "props": {
        "loading": true
      }
    },
    {
      "id": "error",
      "label": "错误",
      "kind": "content",
      "props": {
        "error": "请选择服务类型"
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [
    "item"
  ],
  "events": [
    "update:modelValue",
    "update:open"
  ],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "focus": "color.primary",
    "radius": "radius.md",
    "height": "sizing.control-md",
    "text": "typography.content",
    "muted": "color.on-surface-muted",
    "menuSurface": "color.surface-raised",
    "menuBorder": "border.hairline",
    "menuRadius": "radius.lg",
    "menuElevation": "elevation.level-3",
    "menuItemHeight": "sizing.menu-item",
    "selectedBackground": "color.primary-soft",
    "duration": "motion.duration-normal",
    "easing": "motion.easing-standard",
    "openRotation": "motion.rotate-half-turn",
    "disabledOpacity": "opacity.disabled",
    "menuMaxHeight": "layout.menu-max-height",
    "menuOffset": "spacing.xs-plus",
    "iconSize": "sizing.icon-compact"
  },
  "playground": {
    "presentation": "interactive"
  }
}
