{
  "schemaVersion": 1,
  "id": "menu",
  "category": "input",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "field"
  },
  "summary": "有限选项选择；loading 保持可读忙碌反馈，disabled 使用 opacity.disabled。",
  "behavior": [
    "loading 表示选项正在准备，不得与禁用视觉混同",
    "disabled 阻止打开或选择，整体使用 opacity.disabled"
  ],
  "layout": {
    "summary": "标签在输入表面上方独立排版，不压住边框；标签通过 for/id 与实际输入关联。"
  },
  "visualAnatomy": {
    "summary": "标签、输入表面、状态提示与浮动选项面板分层；loading 与 disabled 共享结构但不共享语义。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "modelValue": {
        "type": "string"
      },
      "options": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "placeholder": {
        "type": "string"
      },
      "clearable": {
        "type": "boolean"
      },
      "loading": {
        "type": "boolean"
      },
      "error": {
        "type": "string"
      },
      "open": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": ["label"]
  },
  "defaultProps": {
    "label": "服务类型",
    "modelValue": "维修",
    "options": ["维修", "巡检", "安装"],
    "placeholder": "请选择服务类型",
    "clearable": true,
    "loading": false,
    "error": "",
    "open": false,
    "disabled": false
  },
  "states": [
    {
      "id": "open",
      "label": "展开菜单",
      "kind": "content",
      "description": "直接体验展开后的选项菜单",
      "props": {
        "open": true
      }
    },
    {
      "id": "loading",
      "label": "加载",
      "kind": "interaction",
      "props": {
        "loading": true
      }
    },
    {
      "id": "error",
      "label": "错误",
      "kind": "content",
      "props": {
        "error": "请选择服务类型"
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": ["item"],
  "events": ["update:modelValue", "update:open"],
  "tokenBindings": {
    "surface": "color.surface",
    "border": "color.border",
    "focus": "color.primary",
    "radius": "radius.control",
    "height": "size.control",
    "text": "typography.content",
    "muted": "color.on-surface-muted",
    "menuSurface": "color.surface-raised",
    "menuBorder": "border.hairline",
    "menuRadius": "radius.surface",
    "menuElevation": "elevation.menu",
    "menuItemHeight": "menu.menu-item-height",
    "selectedBackground": "color.primary-soft",
    "duration": "motion.duration-medium",
    "easing": "motion.easing-standard",
    "disabledOpacity": "opacity.disabled",
    "menuOffset": "menu.offset",
    "iconSize": "size.icon-compact",
    "externalLabel": "typography.label",
    "labelColor": "color.on-surface-muted",
    "labelGap": "spacing.sm"
  },
  "playground": {
    "presentation": "interactive"
  },
  "componentTokens": {
    "menu-item-height": {
      "valueType": "length",
      "default": "{size.control-large}",
      "modeVariant": false,
      "bindable": true
    },
    "offset": {
      "valueType": "length",
      "default": "{space.6}",
      "modeVariant": false,
      "bindable": true
    }
  }
}
