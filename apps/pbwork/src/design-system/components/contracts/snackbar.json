{
  "schemaVersion": 1,
  "id": "snackbar",
  "category": "complex",
  "propsSchema": {
    "type": "object",
    "properties": {
      "modelValue": {
        "type": "boolean"
      },
      "message": {
        "type": "string"
      },
      "tone": {
        "type": "string",
        "enum": [
          "success",
          "error",
          "info"
        ]
      }
    },
    "required": [
      "message"
    ]
  },
  "defaultProps": {
    "modelValue": true,
    "message": "工单已创建",
    "tone": "success"
  },
  "states": [
    {
      "id": "error",
      "label": "错误",
      "props": {
        "message": "提交失败，请重试",
        "tone": "error"
      }
    },
    {
      "id": "hidden",
      "label": "隐藏",
      "props": {
        "modelValue": false
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "accent": "color.success",
    "surface": "color.surface-raised",
    "text": "color.on-surface",
    "radius": "radius.lg",
    "elevation": "elevation.level-4",
    "message": "typography.content"
  }
}
