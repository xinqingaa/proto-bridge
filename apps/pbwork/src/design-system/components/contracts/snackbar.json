{
  "schemaVersion": 1,
  "id": "snackbar",
  "category": "feedback",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "toast"
  },
  "summary": "可撤销的短提示，撤销语义由业务处理。",
  "behavior": [
    "复用 Vuetify snackbar 的超时和 Overlay 机制；不阻断页面操作",
    "每次打开最多撤销一次，撤销事件先于关闭事件；真实数据恢复由业务处理"
  ],
  "layout": {
    "summary": "可撤销的短提示，撤销语义由业务处理。"
  },
  "visualAnatomy": {
    "summary": "使用当前主题的语义色、字阶、间距和受控形状，不在实例上换绑。"
  },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "boolean"
      },
      "message": {
        "type": "string"
      },
      "actionLabel": {
        "type": "string"
      }
    }
  },
  "defaultProps": {
    "modelValue": false,
    "message": "记录已删除",
    "actionLabel": "撤销"
  },
  "states": [
    {
      "id": "visible",
      "label": "可撤销",
      "kind": "content",
      "props": {
        "modelValue": true
      }
    },
    {
      "id": "hidden",
      "label": "已关闭",
      "kind": "content",
      "props": {
        "modelValue": false
      }
    }
  ],
  "slots": [],
  "events": ["update:modelValue", "undo"],
  "tokenBindings": {
    "surface": "color.inverse-surface",
    "color": "color.on-inverse-surface",
    "radius": "radius.surface",
    "padding": "spacing.sm",
    "gap": "spacing.sm",
    "typography": "typography.content",
    "target": "size.touch",
    "focus": "border.focus",
    "duration": "toast.duration",
    "actionPadding": "spacing.xs"
  },
  "playground": {
    "presentation": "trigger"
  }
}
