{
  "schemaVersion": 1,
  "id": "button",
  "category": "action",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "button"
  },
  "summary": "表单与决策区操作，保留中性主要/次要/描边，提供强调、危险和轻量操作。",
  "behavior": [
    "kind为primary / secondary / outlined / accent / danger / quiet，调用方不传自由色槽。",
    "主要决策选择primary或accent，一行仅一个强调动作；两个操作时左侧取消、右侧确认。",
    "描边类型是最弱档，只用于卡片内轻量动作，不进入 Confirm / Sheet / FlowSheet 决策区",
    "loading 时不可点，spinner 与文案同时可见，不得用加载图标替换文字",
    "loading 阻止重复触发但保留强调度；只有 disabled 使用 opacity.disabled",
    "material=glass 复用共享玻璃材质，与操作类型独立；降低透明度时使用清晰实色表面。",
    "accent用于开始/保存等品牌强调；danger用于删除/重置等危险动作；quiet用于跳过/辅助取消，不替代图标关闭或导航。"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "kind": {
        "type": "string",
        "enum": [
          "primary",
          "secondary",
          "outlined",
          "accent",
          "danger",
          "quiet"
        ]
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      },
      "loading": {
        "type": "boolean"
      },
      "block": {
        "type": "boolean"
      },
      "disabled": {
        "type": "boolean"
      },
      "type": {
        "type": "string",
        "enum": [
          "button",
          "submit",
          "reset"
        ]
      },
      "material": {
        "type": "string",
        "enum": [
          "solid",
          "glass"
        ]
      },
      "shape": {
        "type": "string",
        "enum": [
          "rounded",
          "pill"
        ]
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "确认",
    "kind": "primary",
    "size": "md",
    "loading": false,
    "block": false,
    "disabled": false,
    "material": "solid",
    "shape": "rounded"
  },
  "states": [
    {
      "id": "loading",
      "label": "加载",
      "kind": "interaction",
      "props": {
        "loading": true
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    },
    {
      "id": "glass",
      "label": "玻璃材质",
      "kind": "variant",
      "props": {
        "material": "glass"
      }
    },
    {
      "id": "glass-loading",
      "label": "玻璃加载",
      "kind": "interaction",
      "props": {
        "material": "glass",
        "loading": true
      }
    },
    {
      "id": "glass-disabled",
      "label": "玻璃禁用",
      "kind": "interaction",
      "props": {
        "material": "glass",
        "disabled": true
      }
    },
    {
      "id": "accent",
      "label": "开始专注",
      "kind": "variant",
      "props": {
        "kind": "accent",
        "label": "开始专注"
      }
    },
    {
      "id": "danger",
      "label": "删除记录",
      "kind": "variant",
      "props": {
        "kind": "danger",
        "label": "删除记录"
      }
    },
    {
      "id": "quiet",
      "label": "暂时跳过",
      "kind": "variant",
      "props": {
        "kind": "quiet",
        "label": "暂时跳过"
      }
    },
    {
      "id": "pill",
      "label": "胶囊",
      "kind": "variant",
      "props": {
        "shape": "pill"
      }
    }
  ],
  "slots": [
    "default"
  ],
  "events": [
    "click"
  ],
  "tokenBindings": {
    "background": "color.action",
    "border": "color.action",
    "onBackground": "color.on-action",
    "radius": "radius.control",
    "elevation": "none",
    "height": "size.control",
    "paddingX": "spacing.md",
    "typography": "typography.label",
    "disabledOpacity": "opacity.disabled",
    "borderWidth": "border.width",
    "duration": "motion.duration-short",
    "easing": "motion.easing-standard",
    "pressedScale": "motion.press-scale",
    "loaderSize": "size.icon-inline",
    "loaderStroke": "size.stroke",
    "glassTint": "color.glass-tint",
    "glassBackdrop": "surface.glass-backdrop",
    "glassEdge": "border.glass",
    "glassLight": "elevation.glass",
    "glassFallback": "color.surface",
    "glassFallbackBorder": "border.default",
    "glassOutline": "border.default",
    "glassSecondary": "color.on-surface",
    "glassPrimaryTint": "button.glass-primary-tint",
    "tracking": "tracking.label",
    "actionMinInline": "size.action-min-inline"
  },
  "playground": {
    "presentation": "interactive"
  },
  "componentTokens": {
    "glass-primary-tint": {
      "valueType": "color",
      "default": "{color.action}",
      "modeVariant": true,
      "bindable": true,
      "label": "主要操作玻璃底色"
    }
  }
}
