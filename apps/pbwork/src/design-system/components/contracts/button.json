{
  "schemaVersion": 1,
  "id": "button",
  "category": "basic",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": { "type": "string" },
      "variant": {
        "type": "string",
        "enum": ["flat", "tonal", "outlined", "text"]
      },
      "tone": {
        "type": "string",
        "enum": ["primary", "secondary", "error", "success"]
      },
      "radius": {
        "type": "string",
        "enum": ["sm", "md", "lg", "full"]
      },
      "elevated": { "type": "boolean" },
      "disabled": { "type": "boolean" },
      "type": {
        "type": "string",
        "enum": ["button", "submit", "reset"]
      }
    },
    "required": ["label"]
  },
  "defaultProps": {
    "label": "确认",
    "variant": "flat",
    "tone": "primary",
    "radius": "md",
    "elevated": false,
    "disabled": false
  },
  "states": [
    { "id": "disabled", "label": "禁用", "props": { "disabled": true } }
  ],
  "slots": ["default"],
  "events": ["click"],
  "tokenBindings": {
    "background": "color.primary",
    "tonalBackground": "color.primary-soft",
    "onBackground": "color.on-primary",
    "radius": "radius.md",
    "elevation": "elevation.card",
    "typography": "typography.content"
  }
}
