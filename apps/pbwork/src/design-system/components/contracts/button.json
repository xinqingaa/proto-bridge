{
  "schemaVersion": 1,
  "id": "button",
  "category": "basic",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": { "type": "string" },
      "variant": {
        "type": "string",
        "enum": ["flat", "tonal", "outlined", "text"]
      },
      "tone": {
        "type": "string",
        "enum": ["primary", "secondary", "error", "success"]
      },
      "radius": {
        "type": "string",
        "enum": ["sm", "md", "lg", "full"]
      },
      "size": { "type": "string", "enum": ["sm", "md", "lg"] },
      "elevation": { "type": "string", "enum": ["none", "card", "raised"] },
      "elevated": { "type": "boolean" },
      "loading": { "type": "boolean" },
      "block": { "type": "boolean" },
      "disabled": { "type": "boolean" },
      "type": {
        "type": "string",
        "enum": ["button", "submit", "reset"]
      }
    },
    "required": ["label"]
  },
  "defaultProps": {
    "label": "确认",
    "variant": "flat",
    "tone": "primary",
    "radius": "md",
    "size": "md",
    "elevation": "none",
    "loading": false,
    "block": false,
    "disabled": false
  },
  "states": [
    { "id": "tonal", "label": "柔和", "props": { "variant": "tonal" } },
    { "id": "outlined", "label": "描边", "props": { "variant": "outlined" } },
    { "id": "text", "label": "文字", "props": { "variant": "text" } },
    { "id": "loading", "label": "加载", "props": { "loading": true } },
    { "id": "disabled", "label": "禁用", "props": { "disabled": true } }
  ],
  "slots": ["default"],
  "events": ["click"],
  "tokenBindings": {
    "background": "color.primary",
    "tonalBackground": "color.primary-soft",
    "onBackground": "color.on-primary",
    "radius": "radius.md",
    "elevation": "elevation.none",
    "height": "sizing.control-md",
    "typography": "typography.label"
  }
}
