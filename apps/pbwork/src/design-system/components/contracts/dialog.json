{
  "schemaVersion": 1,
  "id": "dialog",
  "category": "complex",
  "propsSchema": {
    "type": "object",
    "properties": {
      "modelValue": {
        "type": "boolean"
      },
      "title": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "confirmLabel": {
        "type": "string"
      },
      "contained": {
        "type": "boolean"
      }
    },
    "required": [
      "title"
    ]
  },
  "defaultProps": {
    "modelValue": true,
    "title": "确认完成工单？",
    "message": "完成后将通知客户，并记录处理结果。",
    "confirmLabel": "确认完成",
    "contained": true
  },
  "states": [
    {
      "id": "closed",
      "label": "关闭",
      "props": {
        "modelValue": false
      }
    }
  ],
  "slots": [
    "default"
  ],
  "events": [
    "update:modelValue",
    "confirm"
  ],
  "tokenBindings": {
    "scrim": "color.scrim",
    "surface": "color.surface-raised",
    "border": "color.border",
    "text": "color.on-surface",
    "radius": "radius.xl",
    "elevation": "elevation.level-5",
    "title": "typography.title",
    "body": "typography.content"
  }
}
