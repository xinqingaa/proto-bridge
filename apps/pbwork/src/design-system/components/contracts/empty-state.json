{
  "schemaVersion": 1,
  "id": "empty-state",
  "category": "complex",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "empty-state"
  },
  "propsSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "actionLabel": {
        "type": "string"
      }
    },
    "required": ["title"]
  },
  "defaultProps": {
    "title": "暂无工单",
    "description": "调整筛选条件，或创建第一张现场工单。",
    "actionLabel": "新建工单"
  },
  "states": [
    {
      "id": "without-action",
      "label": "无操作",
      "props": {
        "actionLabel": ""
      }
    }
  ],
  "slots": [],
  "events": ["action"],
  "tokenBindings": {
    "iconSurface": "color.primary-soft",
    "icon": "color.primary",
    "title": "color.on-surface",
    "description": "color.on-surface-muted",
    "radius": "radius.full",
    "spacing": "spacing.lg",
    "iconSize": "sizing.icon-lg",
    "typography": "typography.subtitle",
    "body": "typography.content",
    "titleOffset": "spacing.xs",
    "descriptionOffset": "spacing.sm",
    "iconSurfaceSize": "sizing.avatar-lg"
  },
  "playground": {
    "presentation": "interactive"
  },
  "icons": {
    "pack": "lucide",
    "defaults": ["inbox"]
  }
}
