{
  "schemaVersion": 1,
  "id": "empty-state",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "empty-state"
  },
  "summary": "没有可展示数据或尚未配置时的完整空态，可选提供一个恢复操作。",
  "behavior": [
    "标题与说明必须解释当前为空的原因或下一步，而不是伪装错误态",
    "actionLabel 为空时不渲染操作入口；存在时通过 action 事件交给页面处理"
  ],
  "propsSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "actionLabel": {
        "type": "string"
      }
    },
    "required": [
      "title"
    ]
  },
  "defaultProps": {
    "title": "暂无工单",
    "description": "调整筛选条件，或创建第一张现场工单。",
    "actionLabel": "新建工单"
  },
  "states": [
    {
      "id": "without-action",
      "label": "无操作",
      "kind": "content",
      "props": {
        "actionLabel": ""
      }
    }
  ],
  "slots": [],
  "events": [
    "action"
  ],
  "tokenBindings": {
    "iconSurface": "color.primary-soft",
    "icon": "color.primary",
    "title": "color.on-surface",
    "description": "color.on-surface-muted",
    "radius": "radius.full",
    "spacing": "spacing.lg",
    "iconSize": "sizing.icon-lg",
    "typography": "typography.subtitle",
    "body": "typography.content",
    "titleOffset": "spacing.xs",
    "descriptionOffset": "spacing.sm",
    "iconSurfaceSize": "sizing.avatar-lg"
  },
  "playground": {
    "presentation": "interactive"
  },
  "icons": {
    "pack": "lucide",
    "defaults": [
      "inbox"
    ]
  }
}
