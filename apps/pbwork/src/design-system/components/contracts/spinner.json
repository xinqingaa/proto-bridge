{
  "schemaVersion": 1,
  "id": "spinner",
  "category": "display",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "loading-state"
  },
  "propsSchema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string"
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      }
    }
  },
  "defaultProps": {
    "label": "正在加载",
    "size": "md"
  },
  "states": [
    {
      "id": "small",
      "label": "小尺寸",
      "props": {
        "size": "sm"
      }
    },
    {
      "id": "large",
      "label": "大尺寸",
      "props": {
        "size": "lg"
      }
    }
  ],
  "slots": [],
  "events": [],
  "tokenBindings": {
    "active": "color.primary",
    "text": "color.on-surface-muted",
    "size": "sizing.icon-md",
    "motion": "motion.duration-slow",
    "label": "typography.caption",
    "stroke": "sizing.indicator-thickness"
  },
  "playground": {
    "presentation": "interactive"
  }
}
