{
  "schemaVersion": 1,
  "id": "switch",
  "category": "basic",
  "semantic": {
    "policy": "fixed",
    "defaultRole": "field"
  },
  "summary": "即时开关；开启色为 Token-ref，禁用走 opacity.disabled。",
  "behavior": [
    "color 只接受 Bind 池 Token ID，禁止硬编码色值",
    "disabled 使用 opacity.disabled"
  ],
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string"
      },
      "modelValue": {
        "type": "boolean"
      },
      "color": {
        "type": "string",
        "description": "Active track Token-ref."
      },
      "disabled": {
        "type": "boolean"
      }
    },
    "required": [
      "label"
    ]
  },
  "defaultProps": {
    "label": "接收进度通知",
    "modelValue": true,
    "color": "color.primary",
    "disabled": false
  },
  "states": [
    {
      "id": "off",
      "label": "关闭",
      "kind": "content",
      "props": {
        "modelValue": false
      }
    },
    {
      "id": "disabled",
      "label": "禁用",
      "kind": "interaction",
      "props": {
        "disabled": true
      }
    }
  ],
  "slots": [],
  "events": [
    "update:modelValue"
  ],
  "tokenBindings": {
    "active": "color.primary",
    "track": "color.surface-variant",
    "thumb": "color.surface",
    "text": "color.on-surface",
    "target": "sizing.touch",
    "label": "typography.content",
    "disabledOpacity": "opacity.disabled"
  },
  "playground": {
    "presentation": "single"
  }
}
