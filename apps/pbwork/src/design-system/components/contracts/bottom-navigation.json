{
  "schemaVersion": 1,
  "id": "bottom-navigation",
  "category": "complex",
  "semantic": { "policy": "fixed", "defaultRole": "bottom-bar" },
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelValue": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "label"],
          "properties": {
            "value": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      },
      "display": {
        "type": "string",
        "enum": ["icon-label", "icon", "label"]
      },
      "showIndicator": {
        "type": "boolean"
      },
      "elevated": { "type": "boolean" }
    },
    "required": ["items"]
  },
  "defaultProps": {
    "modelValue": "one",
    "items": [
      { "value": "one", "label": "首页" },
      { "value": "two", "label": "列表" },
      { "value": "three", "label": "我的" }
    ],
    "display": "icon-label",
    "showIndicator": true,
    "elevated": true
  },
  "states": [
    {
      "id": "second",
      "label": "第二项选中",
      "props": {
        "modelValue": "two"
      }
    },
    {
      "id": "icon-only",
      "label": "纯图标",
      "props": {
        "display": "icon"
      }
    },
    {
      "id": "label-only",
      "label": "纯文字",
      "props": {
        "display": "label"
      }
    }
  ],
  "slots": [],
  "events": ["update:modelValue"],
  "tokenBindings": {
    "surface": "color.surface-raised",
    "active": "color.primary",
    "inactive": "color.on-surface-muted",
    "border": "border.hairline",
    "elevation": "elevation.level-3",
    "target": "sizing.touch",
    "height": "sizing.bottom-navigation",
    "label": "typography.caption",
    "indicatorRadius": "radius.full"
  }
}
