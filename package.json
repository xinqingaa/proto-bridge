{
  "name": "proto-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype-to-implementation context bridge for AI-assisted migration specs.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @proto-bridge/core build && pnpm --filter @proto-bridge/cli build && pnpm --filter @proto-bridge/mcp-server build",
    "typecheck": "pnpm --filter @proto-bridge/core typecheck && pnpm --filter @proto-bridge/cli typecheck && pnpm --filter @proto-bridge/mcp-server typecheck",
    "lint": "pnpm run typecheck",
    "dev": "pnpm --filter @proto-bridge/cli dev",
    "generate": "node scripts/generate.mjs",
    "test:ui-reconstruction": "node scripts/test-ui-reconstruction.mjs all",
    "test:ui-reconstruction:cli": "node scripts/test-ui-reconstruction.mjs cli",
    "test:ui-reconstruction:matrix": "node scripts/test-ui-reconstruction.mjs all --matrix",
    "test:ui-reconstruction:mcp": "node scripts/test-ui-reconstruction.mjs mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "playwright": "^1.49.1",
    "vue-eslint-parser": "^9.4.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
